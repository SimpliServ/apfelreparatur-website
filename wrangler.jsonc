{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apfelreparatur-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Attach once the apfelreparatur.at zone is in the Cloudflare account; the middleware 301s www to the bare domain.
	// "routes": [
	// 	{ "pattern": "apfelreparatur.at", "custom_domain": true },
	// 	{ "pattern": "www.apfelreparatur.at", "custom_domain": true },
	// ],
	"workers_dev": true,
	// Workers Cache in front of the Worker; TTLs come from src/middleware.ts (withCache).
	"cache": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apfelreparatur-website-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "apfelreparatur-website-media",
		},
	],
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
	},
}
