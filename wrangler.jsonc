{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apfelreparatur-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// The middleware 301s www to the bare domain.
	"routes": [
		{ "pattern": "apfelreparatur.at", "custom_domain": true },
		{ "pattern": "www.apfelreparatur.at", "custom_domain": true },
	],
	"workers_dev": true,
	// Workers Cache in front of the Worker; TTLs come from src/middleware.ts (withCache).
	"cache": {
		"enabled": true,
	},
	// Cron purges the page cache once per deployed version (src/worker.ts).
	// Cookieless page/event beacons (src/lib/analytics.ts), shared dataset across the brand sites.
	"analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "site_analytics" }],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apfelreparatur-website-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "apfelreparatur-website-media",
		},
	],
	// Every 15 min (each run costs ~40 ms CPU, forms mail inline); 2-59 keeps minute 17 for the hourly catalogue sync in src/worker.ts.
	"triggers": {
		"crons": ["2-59/15 * * * *"],
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
	},
}
