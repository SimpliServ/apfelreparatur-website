						{
							"_type": "block",
							"_key": "k44",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k45",
									"text": "Ihre Rechte",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k46",
							"style": "normal",
							"markDefs": [
								{
									"_type": "link",
									"_key": "k48",
									"href": "mailto:office@apfelreparatur.at"
								}
							],
							"children": [
								{
									"_type": "span",
									"_key": "k47",
									"text": "Sie haben das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung, Datenübertragbarkeit und Widerspruch. Eine erteilte Einwilligung können Sie jederzeit mit Wirkung für die Zukunft widerrufen. Schreiben Sie uns dazu einfach an ",
									"marks": []
								},
								{
									"_type": "span",
									"_key": "k49",
									"text": "office@apfelreparatur.at",
									"marks": [
										"k48"
									]
								},
								{
									"_type": "span",
									"_key": "k50",
									"text": ".",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k51",
							"style": "normal",
							"markDefs": [
								{
									"_type": "link",
									"_key": "k53",
									"href": "https://www.dsb.gv.at"
								}
							],
							"children": [
								{
									"_type": "span",
									"_key": "k52",
									"text": "Wenn Sie glauben, dass die Verarbeitung Ihrer Daten gegen das Datenschutzrecht verstößt, können Sie sich bei der Österreichischen Datenschutzbehörde beschweren: Barichgasse 40–42, 1030 Wien, ",
									"marks": []
