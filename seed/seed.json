							"children": [
								{
									"_type": "span",
									"_key": "k128",
									"text": "10. Haftung",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k129",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k130",
									"text": "Für Schäden an Personen und für Schäden an den Geräten, die Sie uns zur Reparatur übergeben, haften wir nach den gesetzlichen Bestimmungen. Für sonstige Schäden haften wir bei Vorsatz und grober Fahrlässigkeit; gegenüber Unternehmern ist die Haftung für leichte Fahrlässigkeit ausgeschlossen. Zwingende Bestimmungen des Konsumentenschutzgesetzes bleiben unberührt.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k131",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k132",
									"text": "11. Schlussbestimmungen",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k133",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k134",
									"text": "Es gilt österreichisches Recht unter Ausschluss des UN-Kaufrechts. Für Verbraucher:innen gelten zwingende Schutzvorschriften ihres Wohnsitzstaates weiter. Gerichtsstand für Unternehmer ist Wien. Sollte eine Bestimmung unwirksam sein, bleiben die übrigen wirksam.",
									"marks": []
								}
							]
						}
					]
				}
			}
		]
