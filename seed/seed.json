									"_type": "span",
									"_key": "k43",
									"text": ", verarbeiten wir Ihre Angaben, um den Widerruf zu bearbeiten und den Eingang zu bestätigen (Art. 6 Abs. 1 lit. c DSGVO).",
									"marks": []
