---
import { Image } from "emdash/ui";
import Pic from "./Pic.astro";
import { bySeries, euro, fromPrice, modelPath, type Model } from "../lib/devices";

interface Props {
	models: Model[];
	/** Series filter pills (hub pages); off for short lists like siblings. */
	grouped?: boolean;
	/** Model search above the grid. */
	search?: string;
	/** Show only this many rows until "Alle anzeigen" (needs JS; without it everything stays visible). */
	rows?: number;
}
const { models, grouped = false, search, rows } = Astro.props;
const series = grouped ? bySeries(models).map((g) => g.name) : [];
const price = (m: Model) => fromPrice(m, "display") ?? fromPrice(m, "akku");
const what = (m: Model) => (fromPrice(m, "display") !== null ? "Display ab" : "Batterie ab");
---

<div class="mgrid" data-mgrid data-rows={rows}>
	{
		search && (
			<label class="mgrid__search">
				<span class="sr-only">{search}</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
				<input type="search" placeholder={search} autocomplete="off" data-mgrid-q />
			</label>
		)
	}
	{
		series.length > 1 && (
			<div class="mgrid__pills" role="group" aria-label="Serie" hidden data-mgrid-pills>
				<button type="button" aria-pressed="true" data-series="">Alle</button>
				{series.map((name) => <button type="button" aria-pressed="false" data-series={name}>{name}</button>)}
			</div>
		)
	}
	<ul class="mgrid__list" role="list">
		{
			models.map((m) => (
				<li data-mgrid-item data-series={m.series} data-q={`${m.title} ${m.model_numbers ?? ""}`.toLowerCase()}>
					<a class="mcard" href={modelPath(m)}>
						<span class:list={["mcard__img", { "mcard__img--wide": m.category === "mac" }]}>
							{m.image?.meta?.storageKey || m.image?.src ? (
								<Image image={m.image as never} alt="" sizes="(max-width: 734px) 40vw, 200px" placeholder={false} />
							) : (
								<Pic name="watch" alt="" sizes="200px" class="mcard__photo" />
							)}
						</span>
						<span class="mcard__title">{m.title}</span>
						<span class="mcard__meta">
							{price(m) !== null ? `${what(m)} ${euro(price(m)!)}` : m.model_numbers ? `Modell ${m.model_numbers}` : "Preis nach Diagnose"}
						</span>
					</a>
				</li>
			))
		}
	</ul>
	{
		rows && (
			<div class="mgrid__more" hidden data-mgrid-more>
				<button type="button" class="btn btn--ghost" aria-expanded="false" data-mgrid-toggle>
					Alle {models.length} Modelle anzeigen
				</button>
			</div>
		)
	}
	{search && <p class="mgrid__empty muted" hidden data-mgrid-empty>Kein Modell gefunden. Fragen Sie uns einfach, wir reparieren auch ältere Geräte.</p>}
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-mgrid]")) {
		const q = root.querySelector<HTMLInputElement>("[data-mgrid-q]");
		const pills = root.querySelector<HTMLElement>("[data-mgrid-pills]");
		const empty = root.querySelector<HTMLElement>("[data-mgrid-empty]");
		const list = root.querySelector<HTMLElement>(".mgrid__list")!;
		const more = root.querySelector<HTMLElement>("[data-mgrid-more]");
		const toggle = root.querySelector<HTMLButtonElement>("[data-mgrid-toggle]");
		const rows = Number(root.dataset.rows) || 0;
		const label = toggle?.textContent?.trim() ?? "";
		let series = "";
		let open = false;
		const apply = () => {
			const words = (q?.value ?? "").toLowerCase().split(/\s+/).filter(Boolean);
			// A search or series filter always shows every match; only the unfiltered list is cut to `rows` rows.
			const filtered = !!series || words.length > 0;
			const cols = getComputedStyle(list).gridTemplateColumns.split(" ").filter(Boolean).length || 1;
			const limit = rows && !open && !filtered ? rows * cols : Infinity;
			let shown = 0;
			for (const li of root.querySelectorAll<HTMLElement>("[data-mgrid-item]")) {
				const hit = (!series || li.dataset.series === series) && words.every((w) => (li.dataset.q ?? "").includes(w));
				li.hidden = !hit || shown >= limit;
				if (hit) shown++;
			}
			if (empty) empty.hidden = shown > 0;
			if (more && toggle) {
				more.hidden = filtered || (!open && shown <= limit);
				toggle.textContent = open ? "Weniger anzeigen" : label;
				toggle.setAttribute("aria-expanded", String(open));
			}
		};
		toggle?.addEventListener("click", () => {
			open = !open;
			if (!open) root.scrollIntoView({ block: "start", behavior: "smooth" });
			apply();
		});
		if (rows) {
			let width = 0;
			// Only width changes the column count; reacting to height would loop (apply changes the height).
			new ResizeObserver(([e]) => {
				if (Math.round(e.contentRect.width) === width) return;
				width = Math.round(e.contentRect.width);
				apply();
			}).observe(list);
			apply();
		}
		q?.addEventListener("input", () => {
			if (q.value && series) pills?.querySelector<HTMLButtonElement>('[data-series=""]')?.click();
			apply();
		});
		if (pills) {
			pills.hidden = false;
			pills.addEventListener("click", (e) => {
				const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-series]");
				if (!btn) return;
				series = btn.dataset.series ?? "";
				for (const b of pills.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b === btn));
				apply();
			});
		}
	}
</script>

<style>
	.mgrid__search {
		display: flex;
		align-items: center;
		gap: 10px;
		max-width: 460px;
		margin: 0 auto clamp(32px, 4vw, 48px);
		padding: 0 18px;
		height: 52px;
		border-radius: 980px;
		background: var(--paper);
		border: 1px solid var(--line);
		transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
	}

	.mgrid__search:focus-within {
		border-color: var(--accent);
		box-shadow: 0 0 0 4px var(--accent-ring);
	}

	.mgrid__search svg {
		flex: none;
		width: 20px;
		height: 20px;
		fill: none;
		stroke: var(--muted);
		stroke-width: 2;
		stroke-linecap: round;
	}

	.mgrid__search input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: none;
		font-size: 17px;
		outline: none;
	}

	.mgrid__pills {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		max-width: 980px;
		margin: 0 auto clamp(28px, 3vw, 40px);
	}

	.mgrid__pills button {
		padding: 8px 16px;
		border: 1px solid var(--line);
		border-radius: 980px;
		background: var(--paper);
		color: var(--ink);
		font-size: 14px;
		cursor: pointer;
		transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
	}

	.mgrid__pills button:hover {
		border-color: var(--ink);
	}

	.mgrid__pills button[aria-pressed="true"] {
		background: var(--ink);
		border-color: var(--ink);
		color: #fff;
	}

	.mgrid [hidden] {
		display: none;
	}

	.mgrid__list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
		gap: 16px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.mcard {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 18px 18px 20px;
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
	}

	.mcard:hover {
		text-decoration: none;
		transform: translateY(-4px);
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.22);
	}

	.mcard__img {
		position: relative;
		aspect-ratio: 1;
		margin-bottom: 14px;
		border-radius: 12px;
		background: var(--gray);
		overflow: hidden;
	}

	.mcard__img :global(img) {
		position: absolute;
		inset: 11% 14%;
		width: 72%;
		height: 78%;
		max-width: none;
		object-fit: contain;
		transition: transform 0.6s var(--ease-out);
	}

	.mcard__img--wide :global(img) {
		inset: 6% 4%;
		width: 92%;
		height: 88%;
	}

	.mcard__img :global(.mcard__photo) {
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mcard:hover .mcard__img :global(img) {
		transform: scale(1.05);
	}

	.mcard__title {
		font-size: 17px;
		font-weight: 600;
		line-height: 1.25;
	}

	.mcard__meta {
		margin-top: 4px;
		color: var(--muted);
		font-size: 14px;
	}

	.mgrid__more {
		margin-top: clamp(28px, 3vw, 40px);
		text-align: center;
	}

	.mgrid__empty {
		margin-top: 24px;
		text-align: center;
	}

	@media (max-width: 734px) {
		.mgrid__pills {
			flex-wrap: nowrap;
			justify-content: flex-start;
			margin-inline: calc(-1 * var(--gutter));
			padding-inline: var(--gutter);
			overflow-x: auto;
			scrollbar-width: none;
		}

		.mgrid__pills button {
			flex: none;
		}

		.mgrid__list {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.mcard {
			padding: 12px 12px 16px;
		}
	}
</style>
