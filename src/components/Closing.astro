---
import { business } from "../lib/business";

interface Props {
	title?: string;
	text?: string;
	href?: string;
}
const {
	title = "Ihr Gerät ist in guten Händen.",
	text = "Original Apple Teile, Preis vorab und " + business.warrantyMonths + "\u00a0Monate Garantie. Ohne Termin, in Wien und Umgebung.",
	href = "/kontakt",
} = Astro.props;
---

<section class="closing section">
	<div class="wrap wrap--narrow center" data-reveal>
		<h2 class="t-section">{title}</h2>
		<p class="t-lead muted closing__text">{text}</p>
		<div class="btn-row">
			<a class="btn btn--lg" href={href}>Ohne Termin vorbeikommen</a>
		</div>
	</div>
</section>

<style>
	.closing__text {
		margin: 16px auto 32px;
		max-width: 34ch;
	}
</style>
