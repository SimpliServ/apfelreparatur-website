---
import { decimal, ratings, reviews, reviewsAsOf, thousands } from "../lib/reviews";

const star = "M12 2.2l2.83 6.05 6.63.79-4.9 4.53 1.3 6.55L12 16.84l-5.86 3.28 1.3-6.55-4.9-4.53 6.63-.79z";
const scores = [
	{ key: "google", label: "Google", ...ratings.google, url: undefined as string | undefined },
	{ key: "trustpilot", label: "Trustpilot", ...ratings.trustpilot },
];
---

<section class="reviews section on-gray" aria-labelledby="reviews-h">
	<div class="wrap">
		<header class="center reviews__head" data-reveal>
			<h2 id="reviews-h" class="t-section">Erfahrungen, die für sich sprechen.</h2>
			<p class="t-lead muted">Was Kundinnen und Kunden über unsere Shops in Wien und Umgebung schreiben.</p>
		</header>

		<ul class="scores" role="list">
			{
				scores.map((s, i) => (
					<li class="score" data-reveal style={`--i:${i}`}>
						<p class="score__num">
							<span aria-hidden="true">{decimal(s.score)}</span>
							<span class="sr-only">{`${decimal(s.score)} von 5 Sternen auf ${s.label}`}</span>
						</p>
						<p class="score__src">
							{s.key === "google" ? (
								<svg viewBox="0 0 48 48" aria-hidden="true">
									<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
									<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
									<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
									<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
								</svg>
							) : (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path fill="#00b67a" d="M12 1.5l2.47 7.6h8l-6.47 4.7 2.47 7.6L12 16.7l-6.47 4.7 2.47-7.6L1.53 9.1h8z" />
								</svg>
							)}
							{s.label}
						</p>
						<span class="stars" aria-hidden="true">
							<span class="stars__row">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}</span>
							<span class="stars__row stars__row--on" style={`width:${(s.score / 5) * 100}%`}>
								{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}
							</span>
						</span>
						<p class="score__count muted">
							{s.url ? (
								<a href={s.url} rel="noopener" target="_blank">{`${thousands(s.count)} Bewertungen`}</a>
							) : (
								`${thousands(s.count)} Bewertungen`
							)}
						</p>
					</li>
				))
			}
		</ul>

		<ul class="quotes" role="list">
			{
				reviews.map((r) => (
					<li data-reveal>
						<figure>
							<blockquote>
								<p>„{r.text}“</p>
							</blockquote>
							<figcaption>
								<span>{r.author}</span>{"\u00a0· "}<span>{r.store}</span>{"\u00a0· "}<span>{r.month}</span>
							</figcaption>
						</figure>
					</li>
				))
			}
		</ul>

		<p class="reviews__src">
			Bewertungen der MobiNil Shops, in denen wir reparieren, auf Google Maps und Trustpilot. Zitate aus Google-Bewertungen mit 5 von 5 Sternen, teils
			gekürzt (…). Stand {reviewsAsOf}.
		</p>
	</div>
</section>

<style>
	.reviews__head {
		max-width: 720px;
		margin: 0 auto;
	}

	.reviews__head .t-lead {
		margin-top: 16px;
		text-wrap: balance;
	}

	.scores {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(16px, 6vw, 96px);
		max-width: 720px;
		margin: clamp(48px, 7vw, 88px) auto 0;
		padding: 0;
		list-style: none;
		text-align: center;
	}

	.score {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.score__num {
		margin: 0;
		font-size: clamp(76px, 15vw, 168px);
		line-height: 0.95;
		font-weight: 600;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}

	.score__src {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 8px 0 0;
		font-size: 17px;
		font-weight: 600;
	}

	.score__src svg {
		width: 20px;
		height: 20px;
		flex: none;
	}

	.stars {
		position: relative;
		display: inline-block;
		line-height: 0;
	}

	.stars__row {
		display: inline-flex;
		gap: 2px;
		color: var(--line);
	}

	.stars__row--on {
		position: absolute;
		inset: 0 auto 0 0;
		overflow: hidden;
		color: var(--ink);
	}

	.stars svg {
		width: 18px;
		height: 18px;
		flex: none;
		fill: currentColor;
	}

	.score__count {
		margin: 0;
		font-size: 14px;
	}

	.quotes {
		max-width: 820px;
		margin: clamp(64px, 9vw, 112px) auto 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.quotes li {
		padding-block: clamp(32px, 4.5vw, 48px);
		border-bottom: 1px solid var(--line);
	}

	.quotes figure {
		margin: 0;
	}

	.quotes blockquote {
		margin: 0;
	}

	.quotes p {
		margin: 0;
		font-size: clamp(21px, 1.4vw + 14px, 28px);
		line-height: 1.32;
		font-weight: 600;
		letter-spacing: -0.008em;
		overflow-wrap: break-word;
		text-wrap: pretty;
	}

	.quotes figcaption {
		margin-top: 16px;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.45;
	}

	.quotes figcaption span {
		white-space: nowrap;
	}

	.reviews__src {
		max-width: 820px;
		margin: 24px auto 0;
		color: var(--muted);
		font-size: 12px;
		line-height: 1.5;
		text-align: center;
	}
</style>
