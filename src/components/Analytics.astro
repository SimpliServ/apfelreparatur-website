<!-- Cookieless beacon for src/lib/analytics.ts: page views, engaged time, scroll depth, clicks on call/WhatsApp/mail/directions, form submits and sent forms. -->
<script is:inline>
	(function () {
		if (navigator.webdriver || !navigator.sendBeacon) return;
		var q = new URLSearchParams(location.search), u = {}, maxScroll = 0, since = 0, engaged = 0;
		["source", "medium", "campaign"].forEach(function (k) {
			var v = q.get("utm_" + k) || (k === "source" && q.get("ref"));
			if (v) u[k] = v;
		});
		function send(o) {
			o.p = location.pathname;
			try { navigator.sendBeacon("/_a", JSON.stringify(o)); } catch (e) {}
		}
		send({ t: "pv", r: document.referrer, w: screen.width, u: u });
		if (q.has("gesendet") || q.get("anfrage") === "ok") send({ t: "ev", n: "form_sent", l: location.pathname });
		if (document.visibilityState === "visible") since = Date.now();
		addEventListener("scroll", function () {
			var h = document.documentElement;
			maxScroll = Math.max(maxScroll, Math.min(100, Math.round(((scrollY + innerHeight) / h.scrollHeight) * 100)));
		}, { passive: true });
		document.addEventListener("visibilitychange", function () {
			if (document.visibilityState === "visible") return void (since = Date.now());
			if (since) engaged = Date.now() - since;
			since = 0;
			if (engaged > 0) send({ t: "end", d: engaged, s: maxScroll });
			engaged = 0;
		});
		document.addEventListener("click", function (e) {
			var a = e.target.closest && e.target.closest("a[href]");
			if (!a) return;
			var h = a.href;
			var n = /^tel:/.test(h) ? "call" : /wa\.me|whatsapp/.test(h) ? "whatsapp" : /^mailto:/.test(h) ? "email" : /google\.[a-z.]+\/maps|maps\.app\.goo/.test(h) ? "directions" : /^https?:/.test(h) && a.host !== location.host ? "outbound" : "";
			if (n) send({ t: "ev", n: n, l: n === "outbound" ? a.host : n === "directions" ? (a.textContent || "").trim() : h.replace(/^(tel|mailto):|\?.*$/g, "") });
		}, true);
		document.addEventListener("submit", function (e) {
			send({ t: "ev", n: "form_submit", l: e.target.getAttribute("action") || location.pathname });
		}, true);
	})();
</script>
