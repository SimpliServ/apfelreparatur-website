---
import { Icon } from "astro-iconset/components";
import Wordmark from "./Wordmark.astro";
import NavSearch from "./NavSearch.astro";
import { business, telHref, whatsappHref } from "../lib/business";

const links = [
	["/iphone", "iPhone"],
	["/ipad", "iPad"],
	["/mac", "Mac"],
	["/imac", "iMac"],
	["/apple-watch", "Watch"],
	["/datenrettung", "Datenrettung"],
	["/kontakt", "Kontakt"],
] as const;
const path = Astro.url.pathname;
// The FABs would sit on top of form controls there.
const fab = !["/reparatur-anfragen", "/vertrag-widerrufen"].includes(path.replace(/\/$/, ""));
// Model and repair pages (/iphone/…) keep their device section highlighted.
const current = (href: string) => (path === href ? "page" : href.length > 2 && !href.includes("#") && path.startsWith(href + "/") ? "true" : undefined);
---

<header class="gnav" data-gnav>
	<nav class="gnav__bar" aria-label="Hauptnavigation">
		<a href="/" class="gnav__logo" aria-label="Apfelreparatur – Startseite"><Wordmark height={30} /></a>
		<ul class="gnav__links" role="list">
			{
				links.map(([href, label]) => (
					<li>
						<a href={href} aria-current={current(href)}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<NavSearch />
		<a href={telHref(business.hotline)} class="gnav__call" aria-label={`Gratis Service-Hotline ${business.hotline}`}>
			<Icon name="ph:phone-fill" aria-hidden="true" /><span class="gnav__call-num">Gratis Hotline</span>
		</a>
		<a href="/kontakt" class="gnav__cta">Standorte<span class="gnav__cta-long"> finden</span></a>
		<button type="button" class="gnav__toggle" aria-expanded="false" aria-controls="gnav-menu" aria-label="Menü öffnen" data-gnav-toggle>
			<span></span><span></span>
		</button>
	</nav>
	<div id="gnav-menu" class="gnav__menu" data-gnav-menu>
		<ul role="list">
			{links.map(([href, label], i) => <li style={`--i:${i}`}><a href={href}>{label}</a></li>)}
			<li style={`--i:${links.length}`}><a href="/kontakt">Standorte finden</a></li>
			<li style={`--i:${links.length + 1}`} class="gnav__menu-contact">
				<a href={telHref(business.hotline)}><Icon name="ph:phone-fill" aria-hidden="true" />{business.hotline}</a>
				<a href={whatsappHref} target="_blank" rel="noopener"><Icon name="ph:whatsapp-logo" class="gnav__menu-wa" aria-hidden="true" />WhatsApp 24/7</a>
			</li>
		</ul>
	</div>
</header>
<div class="gnav__curtain" data-gnav-curtain aria-hidden="true"></div>
{
	fab && (
		<div class="fabs" data-fabs>
			<a href={whatsappHref} class="wafab" target="_blank" rel="noopener" aria-label="Per WhatsApp schreiben, rund um die Uhr">
				<span class="wafab__icon">
					<Icon name="ph:whatsapp-logo" aria-hidden="true" />
				</span>
			</a>
		</div>
	)
}

<script>
	const root = document.querySelector<HTMLElement>("[data-gnav]")!;
	const toggle = root.querySelector<HTMLButtonElement>("[data-gnav-toggle]")!;
	const set = (open: boolean) => {
		root.classList.toggle("is-open", open);
		document.documentElement.classList.toggle("gnav-open", open);
		toggle.setAttribute("aria-expanded", String(open));
		toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
	};
	toggle.addEventListener("click", () => set(!root.classList.contains("is-open")));
	root.querySelectorAll("[data-gnav-menu] a").forEach((a) => a.addEventListener("click", () => set(false)));
	addEventListener("keydown", (e) => e.key === "Escape" && set(false));
	matchMedia("(min-width: 1024px)").addEventListener("change", () => set(false));

	const fab = document.querySelector<HTMLElement>("[data-fabs]");
	// The contact buttons leave while the footer's legal row is on screen, so it never covers those links.
	const legal = document.querySelector(".foot__legal");
	if (legal && fab) new IntersectionObserver(([e]) => fab.classList.toggle("is-foot", e.isIntersecting)).observe(legal);
</script>

<style>
	.gnav {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--nav-h);
		background: rgba(250, 250, 252, 0.94);
		backdrop-filter: saturate(180%) blur(20px);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
	}

	.gnav__bar {
		display: flex;
		align-items: center;
		gap: 8px;
		height: var(--nav-h);
		width: min(1360px, calc(100% - 44px));
		margin-inline: auto;
	}

	.gnav__logo {
		display: inline-flex;
		align-items: center;
		height: var(--nav-h);
		margin-right: auto;
		color: var(--ink);
	}

	.gnav__logo:hover {
		text-decoration: none;
		opacity: 0.8;
	}

	.gnav__links {
		display: flex;
		list-style: none;
		padding: 0;
		margin: 0 auto 0 0;
	}

	.gnav__links a {
		display: block;
		padding: 0 14px;
		line-height: var(--nav-h);
		white-space: nowrap;
		font-size: 16px;
		letter-spacing: -0.01em;
		color: rgba(0, 0, 0, 0.8);
		transition: color 0.3s var(--ease);
	}

	.gnav__links a:hover,
	.gnav__links a[aria-current] {
		color: var(--ink);
		text-decoration: none;
	}

	.gnav__links a[aria-current] {
		font-weight: 600;
	}

	.gnav__call {
		display: inline-flex;
		align-items: center;
		flex: none;
		gap: 7px;
		height: 40px;
		border-radius: 980px;
		font-size: 16px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		transition: background-color 0.2s var(--ease);
	}

	.gnav__call {
		padding: 0 16px 0 14px;
		color: var(--accent);
		background: var(--accent-soft);
	}

	.gnav__call:hover {
		text-decoration: none;
		background: #dce6fb;
	}

	.gnav__call :global(svg) {
		width: 19px;
		height: 19px;
		flex: none;
	}

	.gnav__cta {
		font-size: 16px;
		line-height: 1;
		padding: 12px 20px;
		border-radius: 980px;
		background: var(--accent);
		color: #fff;
		white-space: nowrap;
	}

	.gnav__cta:hover {
		background: var(--accent-hover);
		text-decoration: none;
	}

	.gnav__toggle {
		display: none;
		position: relative;
		width: 44px;
		height: var(--nav-h);
		margin-right: -12px;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.gnav__toggle span {
		position: absolute;
		left: 15px;
		width: 14px;
		height: 1.2px;
		border-radius: 1px;
		background: var(--ink);
		transition: transform 0.3s var(--ease), top 0.3s var(--ease);
	}

	.gnav__toggle span:first-child {
		top: calc(50% - 4px);
	}

	.gnav__toggle span:last-child {
		top: calc(50% + 3px);
	}

	.is-open .gnav__toggle span:first-child {
		top: calc(50% - 0.5px);
		transform: rotate(45deg);
	}

	.is-open .gnav__toggle span:last-child {
		top: calc(50% - 0.5px);
		transform: rotate(-45deg);
	}

	.gnav__menu {
		display: none;
	}

	.gnav__curtain {
		display: none;
	}

	/* WhatsApp bottom right on every page. */
	.fabs {
		position: fixed;
		right: 20px;
		bottom: calc(20px + env(safe-area-inset-bottom, 0px));
		z-index: 45;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 12px;
		transition: transform 0.2s var(--ease), opacity 0.2s var(--ease), visibility 0s;
	}

	.wafab {
		display: flex;
		align-items: center;
		gap: 10px;
		color: #fff;
		transition: transform 0.2s var(--ease);
	}

	.wafab:hover {
		text-decoration: none;
		transform: translateY(-2px);
	}

	.wafab:active {
		transform: scale(0.96);
	}

	.wafab__icon {
		display: grid;
		place-items: center;
		width: 67px;
		height: 67px;
		border-radius: 50%;
		background: var(--wa);
		box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4), 0 2px 6px rgba(0, 0, 0, 0.12);
	}

	.wafab__icon :global(svg) {
		width: 35px;
		height: 35px;
	}

	/* visibility (after the fade) also takes the hidden buttons out of the tab order. */
	.fabs:global(.is-foot),
	:global(.gnav-open) .fabs,
	:global(.nsearch-open) .fabs {
		opacity: 0;
		visibility: hidden;
		transform: translateY(24px);
		pointer-events: none;
		transition-delay: 0s, 0s, 0.2s;
	}

	@media (max-width: 734px) {
		.fabs {
			right: 16px;
			bottom: calc(16px + env(safe-area-inset-bottom, 0px));
			gap: 10px;
		}

		.wafab__icon {
			width: 62px;
			height: 62px;
		}
	}

	.gnav__cta-long {
		text-transform: none;
	}

	/* "Gratis Hotline" label fits next to the links down to 1200px. */
	@media (max-width: 1199px) {
		.gnav__call {
			width: 40px;
			padding: 0;
			justify-content: center;
		}

		.gnav__call-num {
			display: none;
		}
	}

	@media (max-width: 1479px) {
		.gnav__links a {
			padding: 0 11px;
		}
	}

	@media (max-width: 1299px) {
		.gnav__cta-long {
			display: none;
		}

		.gnav__cta {
			text-transform: capitalize;
		}
	}

	@media (max-width: 1159px) {
		.gnav__links a {
			padding: 0 8px;
			font-size: 15px;
		}
	}

	/* Phones: the call button wins the slot; "Standorte" stays in the menu. */
	@media (max-width: 480px) {
		.gnav__cta {
			display: none;
		}
	}

	@media (max-width: 420px) {
		.gnav__cta-long {
			display: none;
		}

		.gnav__cta {
			text-transform: capitalize;
		}

		.gnav__bar {
			width: calc(100% - 32px);
		}
	}

	@media (max-width: 1023px) {
		.gnav__links {
			display: none;
		}

		.gnav__cta {
			margin-right: 4px;
		}

		.gnav__menu-contact {
			display: flex;
			flex-wrap: wrap;
			gap: 8px 28px;
			margin-top: 20px;
			padding-top: 20px;
			border-top: 1px solid var(--line);
		}

		.gnav__menu .gnav__menu-contact a {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			font-size: 21px;
			font-variant-numeric: tabular-nums;
		}

		.gnav__menu-contact :global(svg) {
			width: 24px;
			height: 24px;
			color: var(--accent);
		}

		.gnav__menu-contact :global(.gnav__menu-wa) {
			color: var(--wa);
		}

		.gnav__toggle {
			display: block;
		}

		.gnav__logo :global(.wm) {
			width: auto;
			height: 25px;
		}

		.gnav__cta {
			font-size: 15px;
			padding: 10px 16px;
		}

		.gnav__menu {
			display: block;
			position: absolute;
			inset: var(--nav-h) 0 auto 0;
			background: rgba(250, 250, 252, 0.97);
			backdrop-filter: saturate(180%) blur(20px);
			-webkit-backdrop-filter: saturate(180%) blur(20px);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.5s var(--ease);
		}

		.is-open .gnav__menu {
			max-height: calc(100dvh - var(--nav-h));
			overflow: auto;
		}

		.gnav__menu ul {
			list-style: none;
			margin: 0;
			padding: 20px 48px 40px;
		}

		.gnav__menu a {
			display: block;
			padding: 8px 0;
			font-size: 28px;
			line-height: 1.14;
			font-weight: 600;
			letter-spacing: 0.007em;
			color: var(--ink);
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
		}

		.is-open .gnav__menu a {
			opacity: 1;
			transform: none;
			transition-delay: calc(0.1s + var(--i, 0) * 40ms);
		}

		.gnav__curtain {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 40;
			background: rgba(232, 232, 237, 0.4);
			backdrop-filter: blur(20px);
			-webkit-backdrop-filter: blur(20px);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.3s var(--ease);
		}

		:global(.gnav-open) .gnav__curtain {
			opacity: 1;
		}

		:global(.gnav-open) body {
			overflow: hidden;
		}
	}

	@media (max-width: 420px) {
		.gnav__bar {
			gap: 4px;
		}

		.gnav__logo :global(.wm) {
			height: 22px;
		}

		.gnav__cta {
			font-size: 14px;
			padding: 9px 12px;
		}
	}

	/* Menu repeats the CTA; on the narrowest phones it would push the toggle out. */
	@media (max-width: 359px) {
		.gnav__cta {
			display: none;
		}
	}
</style>
