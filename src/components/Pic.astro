---
import { photos, type PhotoKey } from "../lib/photos";

interface Props {
	name: PhotoKey;
	alt?: string;
	sizes?: string;
	class?: string;
	eager?: boolean;
}
const { name, alt, sizes = "100vw", class: cls, eager = false } = Astro.props;
const p = photos[name];
---

<img
	src={`/img/${name}-1600.webp`}
	srcset={`/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w, /img/${name}-2400.webp 2400w`}
	sizes={sizes}
	width={p.w}
	height={p.h}
	alt={alt ?? p.alt}
	class={cls}
	loading={eager ? "eager" : "lazy"}
	fetchpriority={eager ? "high" : undefined}
	decoding="async"
/>
