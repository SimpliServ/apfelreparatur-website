---
import { photos, type PhotoKey } from "../lib/photos";

interface Props {
	name: PhotoKey;
	alt?: string;
	sizes?: string;
	class?: string;
	eager?: boolean;
}
const { name, alt, sizes = "100vw", class: cls, eager = false } = Astro.props;
const p = photos[name];
const q = "v" in p ? `?v=${p.v}` : "";
const src = (w: number) => `/img/${name}-${w}.webp${q}`;
---

<img
	src={src(1600)}
	srcset={`${src(800)} 800w, ${src(1200)} 1200w, ${src(1600)} 1600w, ${src(2400)} 2400w`}
	sizes={sizes}
	width={p.w}
	height={p.h}
	alt={alt ?? p.alt}
	class={cls}
	loading={eager ? "eager" : "lazy"}
	fetchpriority={eager ? "high" : undefined}
	decoding="async"
/>
