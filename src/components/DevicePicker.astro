---
import { Image } from "emdash/ui";
import { Icon } from "astro-iconset/components";
import Pic from "./Pic.astro";
import type { Model } from "../lib/devices";

interface Props {
	models: Model[];
	id?: string;
	title: string;
}
const { models, id, title } = Astro.props;

// Card photo = a catalogue model shot; Watches have none yet, so they fall back to the Pic photo.
const devices = [
	{ href: "/iphone", label: "iPhone", slug: "iphone-17-pro" },
	{ href: "/ipad", label: "iPad", slug: "ipad-air-11-m3-2025" },
	{ href: "/mac", label: "Mac", slug: "macbook-air-13-m2-2022", wide: true },
	{ href: "/apple-watch", label: "Watch", slug: "" },
].map((d) => {
	const m = models.find((x) => x.slug === d.slug);
	return { ...d, image: m?.image?.meta?.storageKey || m?.image?.src ? m.image : null };
});
---

<section id={id} class="picker section" aria-labelledby="picker-h">
	<div class="wrap wrap--xl">
		<h2 id="picker-h" class="t-section picker__title" data-reveal>{title}</h2>
		<ul class="picker__grid" role="list">
			{
				devices.map((d) => (
					<li>
						<a class="pcard" href={d.href}>
							<span class:list={["pcard__img", { "pcard__img--wide": d.wide }]}>
								{d.image ? (
									<Image image={d.image as never} alt="" sizes="(max-width: 734px) 45vw, 280px" placeholder={false} />
								) : (
									<Pic name="watch" alt="" sizes="(max-width: 734px) 45vw, 280px" class="pcard__photo" />
								)}
							</span>
							<span class="pcard__label pcard__more">
								{d.label} Reparatur <Icon name="ph:arrow-right" aria-hidden="true" />
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<a class="pcard pcard--stores" href="/kontakt">
			<span class="pcard__pin"><Icon name="ph:map-pin" aria-hidden="true" /></span>
			<span>
				<span class="pcard__label">Unsere Standorte</span>
				<span class="pcard__text">Finden Sie Ihre nächste Filiale in Wien oder Niederösterreich.</span>
				<span class="pcard__text">Ohne Termin vorbeikommen.</span>
			</span>
			<span class="btn pcard__cta">Standorte ansehen <Icon name="ph:arrow-right" aria-hidden="true" /></span>
		</a>
	</div>
</section>

<style>
	.picker {
		padding-top: 8px;
		background: var(--gray);
	}

	.picker__title {
		margin-bottom: clamp(30px, 3vw, 36px);
		text-align: center;
	}

	.picker__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.pcard {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 20px 20px 22px;
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
	}

	.pcard:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
	}

	.pcard__img {
		position: relative;
		aspect-ratio: 1;
		margin-bottom: 16px;
		border-radius: 12px;
		background: var(--gray);
		overflow: hidden;
	}

	.pcard__img :global(img) {
		position: absolute;
		inset: 11% 14%;
		width: 72%;
		height: 78%;
		object-fit: contain;
	}

	.pcard__img--wide :global(img) {
		inset: 6% 4%;
		width: 92%;
		height: 88%;
	}

	.pcard__img :global(.pcard__photo) {
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pcard__label {
		display: block;
		font-size: 21px;
		font-weight: 600;
		letter-spacing: 0.011em;
	}

	.pcard__more :global(svg) {
		margin-left: 4px;
		vertical-align: -0.125em;
		color: var(--accent);
		transition: transform 0.3s var(--ease-out);
	}

	.pcard:hover .pcard__more :global(svg) {
		transform: translateX(3px);
	}

	.pcard--stores {
		flex-direction: row;
		align-items: center;
		gap: 20px;
		margin-top: 20px;
		padding: 28px 32px;
		border: 1px solid var(--accent-ring);
		background: var(--accent-soft);
	}

	.pcard--stores .pcard__label {
		font-size: 24px;
	}

	/* --muted on --accent-soft is < 4.5:1 */
	.pcard--stores .pcard__text {
		color: var(--ink);
	}

	.pcard__pin {
		display: grid;
		flex: none;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
		font-size: 28px;
	}

	.pcard__text {
		display: block;
		margin-top: 2px;
		color: var(--muted);
		font-size: 15px;
	}

	.pcard__cta {
		flex: none;
		margin-left: auto;
	}

	.pcard--stores:hover .pcard__cta {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	@media (max-width: 833px) {
		.picker__grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.pcard {
			padding: 12px 12px 16px;
		}

		.pcard--stores {
			flex-wrap: wrap;
			gap: 14px;
			margin-top: 12px;
			padding: 20px;
		}

		.pcard--stores > span:nth-child(2) {
			flex: 1 1 0;
			min-width: 0;
		}

		.pcard--stores .pcard__label {
			font-size: 21px;
		}

		.pcard__cta {
			width: 100%;
		}

		.pcard__label {
			font-size: 19px;
		}

		.pcard__more {
			font-size: 16px;
		}
	}
</style>
