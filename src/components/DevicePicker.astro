---
import { Image } from "emdash/ui";
import { Icon } from "astro-iconset/components";
import Pic from "./Pic.astro";
import type { Model } from "../lib/devices";

interface Props {
	models: Model[];
	id?: string;
	title: string;
}
const { models, id, title } = Astro.props;

// Card photo = a catalogue model shot; Watches have none yet, so they fall back to the Pic photo.
const devices = [
	{ href: "/iphone", label: "iPhone", slug: "iphone-17-pro" },
	{ href: "/ipad", label: "iPad", slug: "ipad-air-11-m3-2025" },
	{ href: "/mac", label: "Mac", slug: "macbook-air-13-m2-2022", wide: true },
	{ href: "/apple-watch", label: "Watch", slug: "" },
].map((d) => {
	const m = models.find((x) => x.slug === d.slug);
	return { ...d, image: m?.image?.meta?.storageKey || m?.image?.src ? m.image : null };
});
---

<section id={id} class="picker section" aria-labelledby="picker-h">
	<div class="wrap wrap--xl">
		<h2 id="picker-h" class="t-section picker__title" data-reveal>{title}</h2>
		<ul class="picker__grid" role="list">
			{
				devices.map((d) => (
					<li>
						<a class="pcard" href={d.href}>
							<span class:list={["pcard__img", { "pcard__img--wide": d.wide }]}>
								{d.image ? (
									<Image image={d.image as never} alt="" sizes="(max-width: 734px) 45vw, 280px" placeholder={false} />
								) : (
									<Pic name="watch" alt="" sizes="(max-width: 734px) 45vw, 280px" class="pcard__photo" />
								)}
							</span>
							<span class="pcard__label">{d.label}</span>
							<span class="pcard__more">
								Reparatur <Icon name="ph:arrow-right" aria-hidden="true" />
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<a class="pcard pcard--stores" href="/kontakt">
			<span class="pcard__pin"><Icon name="ph:map-pin" aria-hidden="true" /></span>
			<span>
				<span class="pcard__label">Unsere Standorte</span>
				<span class="pcard__text">Mehrere Standorte in Wien und Niederösterreich. Einfach vorbeikommen.</span>
			</span>
			<Icon name="ph:caret-right" aria-hidden="true" class="pcard__caret" />
		</a>
	</div>
</section>

<style>
	.picker {
		padding-top: 8px;
		background: var(--gray);
	}

	.picker__title {
		margin-bottom: 28px;
		text-align: center;
	}

	.picker__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.pcard {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 20px 20px 22px;
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
	}

	.pcard:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
	}

	.pcard__img {
		position: relative;
		aspect-ratio: 1;
		margin-bottom: 16px;
		border-radius: 12px;
		background: var(--gray);
		overflow: hidden;
	}

	.pcard__img :global(img) {
		position: absolute;
		inset: 11% 14%;
		width: 72%;
		height: 78%;
		object-fit: contain;
	}

	.pcard__img--wide :global(img) {
		inset: 6% 4%;
		width: 92%;
		height: 88%;
	}

	.pcard__img :global(.pcard__photo) {
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pcard__label {
		display: block;
		font-size: 21px;
		font-weight: 600;
		letter-spacing: 0.011em;
	}

	.pcard__more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 4px;
		color: var(--accent);
		font-size: 17px;
	}

	.pcard__more :global(svg) {
		transition: transform 0.3s var(--ease-out);
	}

	.pcard:hover .pcard__more :global(svg) {
		transform: translateX(3px);
	}

	.pcard--stores {
		flex-direction: row;
		align-items: center;
		gap: 18px;
		margin-top: 20px;
	}

	.pcard__pin {
		display: grid;
		flex: none;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 26px;
	}

	.pcard__text {
		display: block;
		margin-top: 2px;
		color: var(--muted);
		font-size: 15px;
	}

	.pcard__caret {
		flex: none;
		margin-left: auto;
		color: var(--muted);
		font-size: 20px;
	}

	@media (max-width: 833px) {
		.picker__grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.pcard {
			padding: 12px 12px 16px;
		}

		.pcard--stores {
			gap: 14px;
			margin-top: 12px;
			padding: 16px;
		}

		.pcard__label {
			font-size: 19px;
		}
	}
</style>
