---
import { Image } from "emdash/ui";
import { Icon } from "astro-iconset/components";
import Pic from "./Pic.astro";
import type { Model } from "../lib/devices";

interface Props {
	models: Model[];
	id?: string;
	title: string;
}
const { models, id, title } = Astro.props;

// Card photo = a catalogue model shot; Watches have none yet, so they fall back to the Pic photo.
// fit = [width, left, top] in % of the tile, measured from each shot's product bounds so every
// device fits the same centred 64 % box (the flat Mac 80 % wide). Re-measure when a photo changes.
const devices = [
	{ href: "/iphone", label: "iPhone", slug: "iphone-17-pro", fit: [33.7, 33.2, 16.7] },
	{ href: "/ipad", label: "iPad", slug: "ipad-air-11-m3-2025", fit: [52.9, 23.6, 14.9] },
	{ href: "/mac", label: "Mac", slug: "macbook-air-13-m2-2022", fit: [109.3, -6.8, 11.6] },
	{ href: "/apple-watch", label: "Watch", slug: "", fit: [166.2, -33.7, -8.5] },
].map((d) => {
	const m = models.find((x) => x.slug === d.slug);
	return { ...d, image: m?.image?.meta?.storageKey || m?.image?.src ? m.image : null };
});
---

<section id={id} class="picker section" aria-labelledby="picker-h">
	<div class="wrap wrap--xl">
		<h2 id="picker-h" class="t-section picker__title" data-reveal>{title}</h2>
		<ul class="picker__grid" role="list">
			{
				devices.map((d) => (
					<li>
						<a class="pcard" href={d.href}>
							<span class="pcard__img" style={`--w:${d.fit[0]}%;--l:${d.fit[1]}%;--t:${d.fit[2]}%`}>
								{d.image ? (
									<Image image={d.image as never} alt="" sizes="(max-width: 734px) 45vw, 280px" placeholder={false} />
								) : (
									<Pic name="watch" alt="" sizes="(max-width: 734px) 75vw, 480px" />
								)}
							</span>
							<span class="pcard__label pcard__more">
								{d.label} <span class="pcard__nowrap">Reparatur <Icon name="ph:arrow-right" aria-hidden="true" /></span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<a class="pcard pcard--stores" href="/kontakt">
			<span>
				<span class="pcard__label">Unsere Standorte</span>
				<span class="pcard__text">Finden Sie Ihre nächste Filiale in Wien oder Niederösterreich.</span>
				<span class="pcard__text">Ohne Termin vorbeikommen.</span>
			</span>
			<span class="btn pcard__cta"><Icon name="ph:map-pin" aria-hidden="true" /> Standorte ansehen</span>
		</a>
	</div>
</section>

<style>
	.picker {
		padding-top: 8px;
		background: var(--gray);
	}

	/* Lifted into the hero's empty bottom so it sits midway between the devices and the cards. */
	.picker__title {
		--lift: clamp(16px, 3.75vw, 54px);
		position: relative;
		z-index: 1;
		margin-top: calc(-1 * var(--lift));
		margin-bottom: calc(clamp(30px, 3vw, 36px) + var(--lift));
		text-align: center;
	}


	.picker__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.pcard {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 20px 20px 22px;
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
	}

	.pcard:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
	}

	.pcard__img {
		position: relative;
		aspect-ratio: 1;
		margin-bottom: 16px;
		border-radius: 12px;
		background: var(--gray);
		overflow: hidden;
	}

	.pcard__img :global(img) {
		position: absolute;
		top: var(--t);
		left: var(--l);
		width: var(--w);
		max-width: none;
		height: auto;
	}

	.pcard__label {
		display: block;
		font-size: 21px;
		font-weight: 600;
		letter-spacing: 0.011em;
	}

	.pcard__nowrap {
		white-space: nowrap;
	}

	.pcard__more :global(svg) {
		margin-left: 4px;
		vertical-align: -0.125em;
		color: var(--accent);
		transition: transform 0.3s var(--ease-out);
	}

	.pcard:hover .pcard__more :global(svg) {
		transform: translateX(3px);
	}

	.pcard--stores {
		flex-direction: row;
		align-items: center;
		gap: 20px;
		margin-top: 20px;
		padding: 28px 32px;
	}

	.pcard--stores .pcard__label {
		font-size: 24px;
	}

	.pcard__text {
		display: block;
		margin-top: 2px;
		color: var(--muted);
		font-size: 15px;
	}

	.pcard__cta {
		flex: none;
		margin-left: auto;
	}

	.pcard--stores:hover .pcard__cta {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	@media (max-width: 833px) {
		.picker__grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.pcard {
			padding: 12px 12px 16px;
		}

		.pcard--stores {
			flex-wrap: wrap;
			gap: 14px;
			margin-top: 12px;
			padding: 20px;
		}

		.pcard--stores > span:first-child {
			flex: 1 1 0;
			min-width: 0;
		}

		.pcard--stores .pcard__label {
			font-size: 21px;
		}

		.pcard__cta {
			width: 100%;
		}

		.pcard__label {
			font-size: 19px;
		}

		.pcard__more {
			font-size: 15px;
		}
	}
</style>
