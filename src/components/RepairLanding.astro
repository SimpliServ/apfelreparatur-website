---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";
import LocalNav from "../components/LocalNav.astro";
import Pic from "../components/Pic.astro";
import Steps from "../components/Steps.astro";
import FAQ from "../components/FAQ.astro";
import Closing from "../components/Closing.astro";
import ModelGrid from "./ModelGrid.astro";
import { de, devices } from "../lib/content";
import { repairPhoto } from "../lib/copy";
import { repairPages, type RepairPage } from "../lib/repair-pages";
import { euro, loadModels, modelPath, REPAIR_OF, useHints } from "../lib/devices";
import { breadcrumbLd, faqLd, organizationLd, serviceLd } from "../lib/seo";

interface Props {
	page: RepairPage;
}
const { page } = Astro.props;

const d = devices[page.device];
const repair = d.repairs.find((r) => r.key === page.service)!;
const c = page.copy;
// People search "MacBook Akku", not "Mac Akku".
const dn = d.key === "mac" ? "MacBook" : d.name;
const name = `${dn} ${c.label}`;
const faq = c.faq(dn);
const { models: all, cacheHint } = await loadModels(page.device);
useHints(Astro, cacheHint);
const rk = REPAIR_OF[page.service] ?? page.service;
const cell = (rows: { repair: string; quality?: string | null; price: number; price_from?: boolean | null }[], q?: string) => {
	const r = rows.filter((x) => x.repair === rk && (!q || x.quality === q)).sort((a, b) => a.price - b.price)[0];
	return r ? (r.price_from ? "ab " : "") + euro(r.price) : "";
};
const priced = all.filter((m) => m.repairs.some((r) => r.repair === rk));
const split = priced.some((m) => m.repairs.some((r) => r.repair === rk && r.quality === "drittanbieter"));
const description = c.desc(dn);
const siblings = repairPages.filter((p) => p.device === page.device && p.path !== page.path);
const anfrage = `/reparatur-anfragen?geraet=${d.key}&anliegen=${page.service}`;
---

<Base
	og={d.key}
	title={c.title(dn)}
	description={description}
	jsonLd={[
		organizationLd(),
		serviceLd(`${name} in Wien`, description, page.path, `${dn} ${c.label}`),
		faqLd(faq),
		breadcrumbLd([["Start", "/"], [`${d.name} Reparatur`, `/${d.key}`], [c.label, page.path]]),
	]}
>
	<LocalNav title={name} links={[["#symptome", "Symptome"], ["#ablauf", "Ablauf"], ["#modelle", "Modelle"], ["#faq", "Fragen"]]} cta={{ href: anfrage, label: "Anfragen" }} />

	<header class="hero">
		<div class="wrap center rise">
			<p class="t-eyebrow muted"><a href={`/${d.key}`}>{d.name} Reparatur</a></p>
			<h1 class="t-display hero__title">{name} <span class="hero__city">in Wien.</span></h1>
			<p class="t-hero-sub hero__sub">{c.sub(dn)}<a class="fn" href="#fn-1">1</a></p>
			<div class="btn-row">
				<a class="btn" href={anfrage}>Reparatur anfragen</a>
				<a class="btn btn--ghost" href="/kontakt">Standorte ansehen</a>
			</div>
		</div>
		<figure class="hero__img wrap wrap--xl sd-grow">
			<Pic name={repairPhoto(d.key, page.service)} eager sizes="(max-width: 1260px) 100vw, 1260px" />
		</figure>
	</header>

	<section id="symptome" class="section on-gray" aria-labelledby="symptome-h">
		<div class="wrap wrap--xl">
			<h2 id="symptome-h" class="t-section intro" data-reveal>Woran Sie es erkennen.</h2>
			<ul class="signs" role="list">
				{
					c.signs.filter((s) => !s.skip?.includes(dn)).map((s, i) => (
						<li class="card" data-reveal style={`--i:${i}`}>
							<Icon name={s.icon} class="icon-lg" aria-hidden="true" />
							<h3>{s.title}</h3>
							<p class="muted">{s.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="get-h">
		<div class="wrap wrap--xl get">
			<div data-reveal>
				<h2 id="get-h" class="t-section">{repair.title}</h2>
				<p class="t-lead get__text">{repair.text}</p>
			</div>
			<ul class="get__points" role="list" data-reveal>
				{
					repair.points.map((p) => (
						<li>
							<Icon name="ph:check-circle-fill" aria-hidden="true" />
							{p}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<Steps id="ablauf" title="So läuft die Reparatur." items={c.steps(dn)} />

	<section id="modelle" class="section on-gray" aria-labelledby="models-h">
		<div class="wrap wrap--xl">
			<div class="mhead" data-reveal>
				<h2 id="models-h" class="t-section">{priced.length ? `${c.label}: Preise für jedes ${dn}.` : `${c.label} für jedes ${dn}.`}</h2>
				<p class="t-lead muted">{priced.length ? "Fixpreise je Modell. Wählen Sie Ihr Modell für alle Reparaturen und Details." : "Wählen Sie Ihr Modell. Den Preis nennen wir Ihnen nach der Diagnose, vor der Reparatur."}</p>
			</div>
			{
				priced.length > 0 ? (
					<div class="ptable" data-reveal>
						<table>
							<thead>
								<tr>
									<th scope="col">Modell</th>
									{split ? (
										<>
											<th scope="col">Original Apple<a class="fn" href="#fn-1">1</a></th>
											<th scope="col">Kompatibel</th>
										</>
									) : (
										<th scope="col">Preis</th>
									)}
								</tr>
							</thead>
							<tbody>
								{priced.map((m) => (
									<tr>
										<th scope="row"><a href={modelPath(m)}>{m.title}</a></th>
										{split ? (
											<>
												<td>{cell(m.repairs, "original") || "–"}</td>
												<td>{cell(m.repairs, "drittanbieter") || "–"}</td>
											</>
										) : (
											<td>{cell(m.repairs)}</td>
										)}
									</tr>
								))}
							</tbody>
						</table>
						<p class="ptable__note muted">Zuzüglich 19,99 € Arbeitspauschale je Reparatur. Ihr Modell fehlt? <a href={anfrage}>Fragen Sie uns</a>.</p>
					</div>
				) : (
					<ModelGrid models={all} grouped />
				)
			}
		</div>
	</section>

	<FAQ title={`Fragen zur ${name}.`} items={faq} />

	{
		siblings.length > 0 && (
			<nav class="section on-gray more-rep" aria-labelledby="more-h">
				<div class="wrap wrap--xl">
					<h2 id="more-h" class="t-title">Weitere {dn} Reparaturen</h2>
					<ul role="list">
						{siblings.map((s) => (
							<li>
								<a class="more" href={s.path}>
									{dn} {s.copy.label} <Icon name="ph:caret-right" aria-hidden="true" />
								</a>
							</li>
						))}
						<li>
							<a class="more" href="/datenrettung">
								Datenrettung <Icon name="ph:caret-right" aria-hidden="true" />
							</a>
						</li>
					</ul>
				</div>
			</nav>
		)
	}

	<Closing title={`${de(dn).ihr} ${dn}. Bald wieder wie neu.`} href={anfrage} />
</Base>

<style>
	.hero {
		padding: clamp(56px, 8vw, 96px) 0 clamp(40px, 5vw, 64px);
		overflow: hidden;
	}

	.hero .t-eyebrow a {
		color: inherit;
	}

	.hero__title {
		margin-top: 6px;
	}

	.hero__city {
		display: block;
		color: var(--muted);
	}

	.hero__sub {
		max-width: 32ch;
		margin: 18px auto 28px;
		color: var(--ink-2);
	}

	.hero__img {
		margin-top: clamp(48px, 6vw, 72px);
	}

	.hero__img :global(img) {
		width: 100%;
		aspect-ratio: 16 / 8;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.intro {
		margin-bottom: clamp(32px, 4vw, 56px);
	}

	.signs {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.signs h3 {
		margin: 22px 0 6px;
		font-size: 21px;
		font-weight: 600;
	}

	.get {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(32px, 6vw, 88px);
		align-items: start;
	}

	.get__text {
		margin-top: 18px;
		color: var(--ink-2);
	}

	.get__points {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.get__points li {
		display: flex;
		gap: 14px;
		align-items: center;
		padding: 20px 0;
		border-bottom: 1px solid var(--line);
		font-size: 19px;
		font-weight: 500;
	}

	.get__points svg {
		flex: none;
		width: 24px;
		height: 24px;
		color: var(--accent);
	}

	.mhead {
		max-width: 760px;
		margin-bottom: clamp(28px, 4vw, 48px);
	}

	.mhead .t-lead {
		margin-top: 12px;
	}

	.ptable {
		max-width: 920px;
		padding: clamp(8px, 2vw, 16px) clamp(16px, 3vw, 36px) clamp(20px, 3vw, 32px);
		border-radius: var(--radius-lg);
		background: var(--paper);
	}

	.ptable table {
		width: 100%;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}

	.ptable :is(th, td) {
		padding: 14px 8px;
		border-bottom: 1px solid var(--line);
		text-align: right;
		white-space: nowrap;
	}

	.ptable :is(th, td):first-child {
		text-align: left;
		white-space: normal;
	}

	.ptable thead th {
		color: var(--muted);
		font-size: 14px;
		font-weight: 500;
	}

	.ptable tbody th {
		font-weight: 500;
	}

	.ptable tbody th a {
		color: var(--ink);
	}

	.ptable tbody th a:hover {
		color: var(--accent);
	}

	.ptable td {
		font-weight: 600;
	}

	.ptable tbody tr:last-child :is(th, td) {
		border-bottom: 0;
	}

	.ptable__note {
		margin-top: 14px;
		font-size: 12px;
	}

	.more-rep ul {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 32px;
		list-style: none;
		margin: 20px 0 0;
		padding: 0;
		font-size: 19px;
	}

	.more-rep svg {
		width: 0.75em;
		height: 0.75em;
	}

	@media (max-width: 1000px) {
		.signs {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 760px) {
		.get {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.signs {
			grid-template-columns: 1fr;
		}
	}
</style>
