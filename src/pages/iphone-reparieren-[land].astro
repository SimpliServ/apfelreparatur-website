---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";
import StoreList from "../components/StoreList.astro";
import FAQ from "../components/FAQ.astro";
import Closing from "../components/Closing.astro";
import { business } from "../lib/business";
import { deviceList, imac, services } from "../lib/content";
import { getLocations } from "../lib/mobinil";
import { h1Of, nearest, opensSunday, regionBySlug, regionPath, regions } from "../lib/regions";
import { breadcrumbLd, faqLd, organizationLd, regionServiceLd } from "../lib/seo";

// Federal-state pages /iphone-reparieren-<land>, copy in src/lib/regions.ts.
const r = regionBySlug(Astro.params.land ?? "");
if (!r) return Astro.rewrite("/404");

const path = regionPath(r);
const h1 = h1Of(r);
const [lat, lng] = r.center;
const near = (l: { lat: number; lng: number }) => Math.hypot(l.lat - lat, (l.lng - lng) * Math.cos((lat * Math.PI) / 180));
const locations = (await getLocations()).sort((a, b) => near(a) - near(b));
const faq = r.faq({ sunday: locations.filter(opensSunday) });
const crumbs: [string, string][] = [["Start", "/"], ["Standorte", "/kontakt"], [r.name, path]];
const rows = r.towns.map((t) => ({ town: t.replace(/^Wien-/, ""), ...nearest(t) }));
const devices = [...deviceList.map((d) => ({ ...d, href: `/${d.key}`, name: d.key === "mac" ? "MacBook" : d.name })), { ...imac, href: "/imac" }];
const others = regions.filter((x) => x.slug !== r.slug);
---

<Base
	og="kontakt"
	title={r.title}
	description={r.description}
	jsonLd={[
		organizationLd(),
		regionServiceLd({ name: `Apple Reparatur ${r.name}`, state: r.name, wikidata: r.wikidata, description: r.description, path }),
		faqLd(faq),
		breadcrumbLd(crumbs),
	]}
>
	<header class="rhead">
		<div class="wrap wrap--xl rise">
			<p class="t-eyebrow muted">Apple Reparatur {r.name}</p>
			<h1 class="t-display rhead__h">{h1}</h1>
			<p class="t-lead rhead__lead">{r.lead}</p>
			<div class="btn-row rhead__btns">
				<a class="btn btn--ghost" href="#entfernung">Nächster Standort</a>
				<a class="btn" href="/reparatur-anfragen">Reparatur anfragen</a>
			</div>
		</div>
	</header>

	<section id="entfernung" class="section rsec-top" aria-labelledby="entfernung-h">
		<div class="wrap wrap--xl rgrid">
			<div data-reveal>
				<h2 id="entfernung-h" class="t-section">Wie weit ist es zu uns?</h2>
				<p class="muted rnote">Nächster Standort und Entfernung in Luftlinie, gerundet. Die Fahrstrecke ist länger.</p>
				<table class="rkm">
					<thead>
						<tr><th scope="col">Von</th><th scope="col">Nächster Standort</th><th scope="col" class="num">km</th></tr>
					</thead>
					<tbody>
						{
							rows.map((x) => (
								<tr>
									<th scope="row">{x.town}</th>
									<td><span class="rlong">{x.store}</span><span class="rshort">{x.short}</span></td>
									<td class="num">{x.km}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<div data-reveal>
				<h2 class="t-title rstores__h">Unsere Standorte</h2>
				<StoreList stores={locations} />
				<p class="muted rnote">Ohne Termin, Preis vor der Reparatur, {business.warrantyMonths} Monate Garantie.<a class="fn" href="#fn-3">3</a></p>
			</div>
		</div>
	</section>

	<section class="section on-gray" aria-label={`Anfahrt ${r.inName}`}>
		<div class="wrap wrap--narrow rguide">
			{
				r.guide.map((g) => (
					<div data-reveal>
						<h2 class="t-title">{g.h}</h2>
						{g.p.map((p) => <p class="t-lead">{p}</p>)}
					</div>
				))
			}
		</div>
	</section>

	<section class="section" aria-labelledby="geraete-h">
		<div class="wrap wrap--xl">
			<h2 id="geraete-h" class="t-section rdev__h" data-reveal>Was wir reparieren.</h2>
			<ul class="rdev" role="list">
				{
					devices.map((d, i) => (
						<li data-reveal style={`--i:${i}`}>
							<a class="card card--gray rdev__card" href={d.href}>
								<h3>{d.name} Reparatur</h3>
								<p class="muted">{d.repairs.map((x) => services[x.key].label).join(", ")}</p>
							</a>
						</li>
					))
				}
				<li data-reveal style={`--i:${devices.length}`}>
					<a class="card card--gray rdev__card" href="/datenrettung">
						<h3>Datenrettung</h3>
						<p class="muted">Datenrettung und Datenübertragung für iPhone, iPad und Mac</p>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<FAQ title={`Fragen zur Apple Reparatur ${r.inName}.`} items={faq} />

	<nav class="section on-gray" aria-labelledby="laender-h">
		<div class="wrap wrap--xl">
			<h2 id="laender-h" class="t-title">iPhone reparieren lassen in ganz Österreich</h2>
			<ul class="rland" role="list">
				{
					others.map((x) => (
						<li>
							<a class="more" href={regionPath(x)}>
								{x.name} <Icon name="ph:caret-right" aria-hidden="true" />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>

	<Closing title={`Aus ${r.name} zu uns.`} text="Kein Termin nötig. Den Preis nennen wir vor der Reparatur, repariert wird erst nach Ihrer Zustimmung." />
</Base>

<style>
	.rsec-top {
		padding-top: 0;
	}

	.rhead {
		padding: clamp(56px, 8vw, 96px) 0 clamp(48px, 6vw, 80px);
	}

	.rhead__h {
		max-width: 18ch;
		margin-top: 8px;
		text-wrap: balance;
	}

	.rhead__lead {
		max-width: 60ch;
		margin-top: 20px;
		color: var(--ink-2);
	}

	.rhead__btns {
		justify-content: flex-start;
		margin-top: 28px;
	}

	.rgrid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: clamp(40px, 6vw, 88px);
		align-items: start;
	}

	.rnote {
		margin: 12px 0 24px;
		font-size: 15px;
	}

	.rstores__h {
		margin-bottom: 20px;
	}

	.rkm {
		width: 100%;
		border-collapse: collapse;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--gray);
		font-size: 16px;
	}

	.rkm th,
	.rkm td {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}

	.rkm thead th {
		color: var(--muted);
		font-size: 13px;
		font-weight: 500;
	}

	.rkm tbody th {
		font-weight: 600;
	}

	.rkm tr:last-child > * {
		border-bottom: 0;
	}

	.rkm .num {
		text-align: right;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.rguide {
		display: grid;
		gap: clamp(40px, 5vw, 56px);
	}

	.rguide p {
		margin-top: 14px;
		color: var(--ink-2);
	}

	.rdev__h {
		margin-bottom: clamp(32px, 4vw, 48px);
	}

	.rdev {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rdev__card {
		display: block;
		height: 100%;
		color: var(--ink);
		text-decoration: none;
	}

	.rdev__card h3 {
		margin-bottom: 6px;
		font-size: 21px;
		font-weight: 600;
		color: var(--accent);
	}

	.rland {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		list-style: none;
		margin: 20px 0 0;
		padding: 0;
	}

	.rland svg {
		width: 0.75em;
		height: 0.75em;
	}

	@media (max-width: 900px) {
		.rgrid,
		.rdev {
			grid-template-columns: 1fr;
		}
	}

	.rshort {
		display: none;
	}

	@media (max-width: 480px) {
		.rlong {
			display: none;
		}

		.rshort {
			display: inline;
		}

		.rkm th,
		.rkm td {
			padding: 10px 10px;
		}
	}
</style>
