---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";
import { business, telHref, whatsappHref } from "../lib/business";
import { getLocations } from "../lib/mobinil";
import { breadcrumbLd, faqLd, localBusinessLd } from "../lib/seo";
import StoreCard from "../components/StoreCard.astro";
import FAQ from "../components/FAQ.astro";
import type { QA } from "../components/FAQ.astro";

const locations = await getLocations();
const groups = [...new Set(locations.map((l) => l.name))].map((name) => [name, locations.filter((l) => l.name === name)] as const);
const DAYS = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"];
// Hours labels look like "Mo – Fr", "Sa" or "Mo, Mi"; day is 0 = Monday.
const opensOn = (l: (typeof locations)[number], day: number) =>
	l.hours.some(([label]) =>
		label.split(", ").some((part) => {
			const [from, to = from] = part.split(" – ").map((d) => DAYS.indexOf(d.trim()));
			return from <= day && day <= to;
		}),
	);
const sunday = locations.filter((l) => opensOn(l, 6));
const faq: QA[] = [
	{ q: "Brauche ich einen Termin?", a: "Nein. Kommen Sie einfach an einen unserer Standorte, ein Termin ist nicht nötig." },
	{ q: "Haben Sie am Wochenende geöffnet?", a: `Ja, ${locations.every((l) => opensOn(l, 5)) ? "alle Standorte haben" : "viele Filialen haben"} am Samstag geöffnet${sunday.length ? `, ${[...new Set(sunday.map((l) => l.name))].join(" und ")} auch am Sonntag` : ""}. Die genauen Zeiten stehen bei jeder Filiale.` },
	{ q: "Welcher Standort ist für mich der richtige?", a: "Alle Standorte reparieren iPhone, iPad, Mac und Apple Watch. Wählen Sie einfach den, der für Sie am besten liegt." },
	{ q: "Kann ich anrufen, bevor ich komme?", a: `Gerne. Die gratis Service-Hotline ${business.hotline}, die Nummer der Filiale oder rund um die Uhr per WhatsApp (Button oben).` },
];
---

<Base
	og="kontakt"
	title="Standorte – Apple Reparatur Wien ohne Termin"
	description="Apfelreparatur in Wien und Umgebung: Wien Hauptbahnhof, Shopping City Süd und G3 Gerasdorf. Ohne Termin vorbeikommen, Öffnungszeiten und Telefonnummern."
	jsonLd={[...localBusinessLd(locations), faqLd(faq), breadcrumbLd([["Start", "/"], ["Kontakt und Standorte", "/kontakt"]])]}
>
	<header class="khead">
		<div class="wrap wrap--xl rise">
			<h1 class="t-display">Kontakt und Standorte.</h1>
			<p class="t-hero-sub muted khead__sub">Kommen Sie einfach vorbei, ein Termin ist nicht nötig. In Wien und Umgebung, auch am Wochenende.</p>
			<div class="hotlines">
				<a class="hotline" href={telHref(business.hotline)}>
					<Icon name="ph:phone" aria-hidden="true" />
					<span>
						<span class="hotline__label">Gratis Service-Hotline</span>
						<span class="hotline__num">{business.hotline}</span>
					</span>
				</a>
				<a class="hotline hotline--wa" href={whatsappHref} target="_blank" rel="noopener">
					<Icon name="ph:whatsapp-logo" aria-hidden="true" />
					<span>
						<span class="hotline__label">WhatsApp, rund um die Uhr</span>
						<span class="hotline__num">Chat 24/7</span>
					</span>
				</a>
			</div>
		</div>
	</header>

	<section class="section kloc" aria-label="Standorte">
		<div class="wrap wrap--xl">
			{
				groups.map(([name, list], gi) => (
					<div class="kgroup" data-reveal style={`--i:${gi}`}>
						<h2 class="t-title kgroup__h">
							<Icon name="ph:map-pin" aria-hidden="true" />
							{name}
						</h2>
						<ul class="kgrid" role="list">
							{list!.map((l) => <StoreCard store={l} />)}
						</ul>
					</div>
				))
			}
			<div class="kmail card" data-reveal>
				<Icon name="ph:envelope-simple" class="icon-lg" aria-hidden="true" />
				<div>
					<h2 class="t-title">Lieber schreiben?</h2>
					<p class="muted">
						Senden Sie uns eine Nachricht oder schreiben Sie an <a href={`mailto:${business.email}`}>{business.email}</a>.
					</p>
				</div>
				<a class="btn" href="/reparatur-anfragen">Nachricht schreiben</a>
			</div>
		</div>
	</section>

	<FAQ title="Fragen zu den Standorten." items={faq} />
</Base>

<style>
	.khead {
		padding: clamp(56px, 8vw, 96px) 0 0;
	}

	.khead__sub {
		max-width: 32ch;
		margin-top: 16px;
	}

	.hotlines {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.hotline.hotline--wa > :global(svg) {
		background: var(--wa);
	}

	.hotline {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		padding: 16px 28px 16px 20px;
		border-radius: var(--radius);
		background: var(--gray);
		color: var(--ink);
		transition: transform 0.4s var(--ease-out), background-color 0.3s var(--ease);
	}

	.hotline:hover {
		text-decoration: none;
		background: #ebebef;
		transform: scale(1.015);
	}

	.hotline > :global(svg) {
		width: 40px;
		height: 40px;
		padding: 9px;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
	}

	.hotline__label {
		display: block;
		font-size: 14px;
		color: var(--muted);
	}

	.hotline__num {
		display: block;
		font-size: clamp(24px, 3vw, 32px);
		line-height: 1.15;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.01em;
	}

	.kgroup + .kgroup {
		margin-top: 56px;
	}

	.kgroup__h {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 20px;
	}

	.kgroup__h svg {
		width: 28px;
		height: 28px;
		color: var(--muted);
	}

	.kgrid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.kmail {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-top: 64px;
		background: var(--gray);
	}

	.kmail .t-title {
		margin-bottom: 4px;
	}

	.kmail .btn {
		margin-left: auto;
	}

	@media (max-width: 1000px) {
		.kgrid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.kgrid {
			grid-template-columns: 1fr;
		}

		.kmail {
			flex-direction: column;
			align-items: flex-start;
		}

		.kmail .btn {
			margin-left: 0;
		}
	}
</style>
