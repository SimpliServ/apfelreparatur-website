---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";
import Tile from "../components/Tile.astro";
import PlusCards from "../components/PlusCards.astro";
import Steps from "../components/Steps.astro";
import FAQ from "../components/FAQ.astro";
import Closing from "../components/Closing.astro";
import { homeFaq, steps, whyCards } from "../lib/copy";
import { faqLd, localBusinessLd, websiteLd } from "../lib/seo";
import { business } from "../lib/business";
import { getLocations } from "../lib/mobinil";
import { deviceList } from "../lib/content";
import { repairPages } from "../lib/repair-pages";

const locations = await getLocations();
const places = [...new Set(locations.map((l) => l.name))];
const directory = [
	...deviceList.map((d) => {
		const dn = d.key === "mac" ? "MacBook" : d.name;
		return { title: `${dn} Reparatur`, href: `/${d.key}`, links: repairPages.filter((p) => p.device === d.key).map((p) => [p.path, `${dn} ${p.copy.label}`] as const) };
	}),
	{ title: "Daten", href: "/datenrettung", links: [["/datenrettung", "Datenrettung für iPhone, iPad und Mac"], ["/datenrettung#uebertragung", "Datenübertragung aufs neue Gerät"]] as const },
];

const chapters = [
	["/iphone", "ph:device-mobile", "iPhone"],
	["/ipad", "ph:device-tablet", "iPad"],
	["/mac", "ph:laptop", "Mac"],
	["/datenrettung", "ph:database", "Datenrettung"],
	["/datenrettung#uebertragung", "ph:arrows-left-right", "Datenübertragung"],
	["/reparatur-anfragen", "ph:wrench", "Anfragen"],
] as const;
---

<Base
	title="iPhone Reparatur Wien ohne Termin – Apfelreparatur"
	description={`iPhone Reparatur in Wien ohne Termin: Display, Akku und Rückglas mit Original Apple Teilen. Auch iPad, MacBook, Datenrettung. Preis vorab, ${business.warrantyMonths} Monate Garantie.`}
	jsonLd={[websiteLd(), ...localBusinessLd(locations), faqLd(homeFaq)]}
>
	<nav class="chapters" aria-label="Geräte und Leistungen">
		<ul role="list" class="rise">
			{
				chapters.map(([href, icon, label]) => (
					<li>
						<a href={href}>
							<Icon name={icon} aria-hidden="true" />
							<span>{label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<Tile
		heading="h1"
		dark
		eager
		photo="hero"
		eyebrow="iPhone Reparatur in Wien"
		title="Wie am ersten Tag."
		sub={'Premium Reparaturen mit Original Apple Teilen.<a class="fn" href="#fn-1">1</a>'}
		primary={{ href: "/reparatur-anfragen", label: "Reparatur anfragen" }}
		secondary={{ href: "/iphone", label: "Mehr erfahren" }}
	/>

	<div class="grid">
		<Tile
			half
			dark
			photo="display"
			title="Display."
			sub="Gesprungen? Bald wieder makellos."
			primary={{ href: "/reparatur-anfragen?geraet=iphone&anliegen=display", label: "Anfragen" }}
			secondary={{ href: "/iphone/display-reparatur", label: "Mehr erfahren" }}
		/>
		<Tile
			half
			dark
			photo="rueckglas"
			title="Rückglas."
			sub="Die Rückseite, wieder aus einem Guss."
			primary={{ href: "/reparatur-anfragen?geraet=iphone&anliegen=rueckglas", label: "Anfragen" }}
			secondary={{ href: "/iphone/rueckglas-reparatur", label: "Mehr erfahren" }}
		/>
		<Tile
			half
			dark
			photo="akku"
			title="Akku."
			sub="Wieder 100 % Batteriezustand."
			primary={{ href: "/reparatur-anfragen?geraet=iphone&anliegen=akku", label: "Anfragen" }}
			secondary={{ href: "/iphone/akku-tauschen", label: "Mehr erfahren" }}
		/>
		<Tile
			half
			photo="daten"
			title="Datenrettung."
			sub="Fotos, Nachrichten, Dateien. Zurückgeholt."
			primary={{ href: "/reparatur-anfragen?anliegen=datenrettung", label: "Anfragen" }}
			secondary={{ href: "/datenrettung", label: "Mehr erfahren" }}
		/>
		<Tile
			half
			photo="ipad"
			title="iPad."
			sub="Glas, Display und Akku. Wie neu."
			primary={{ href: "/reparatur-anfragen?geraet=ipad", label: "Anfragen" }}
			secondary={{ href: "/ipad", label: "Mehr erfahren" }}
		/>
		<Tile
			half
			dark
			photo="mac-hero"
			title="Mac."
			sub="MacBook Air, MacBook Pro und iMac."
			primary={{ href: "/reparatur-anfragen?geraet=mac", label: "Anfragen" }}
			secondary={{ href: "/mac", label: "Mehr erfahren" }}
		/>
	</div>

	<PlusCards id="warum" title="Warum Apfelreparatur." link={{ href: "/#garantie", label: "Garantie und Bedingungen ›" }} cards={whyCards} />

	<Steps id="ablauf" title="So einfach geht’s." items={steps} />

	<section class="workshop on-dark" id="garantie">
		<div class="wrap workshop__copy" data-reveal>
			<p class="t-eyebrow muted">Unsere Arbeitsweise</p>
			<h2 class="t-display sd-text">Präzision in jedem Detail.</h2>
			<p class="t-lead workshop__lead">
				Jede Reparatur beginnt mit einer gründlichen Diagnose. Wir tauschen nur, was wirklich defekt ist, testen jede Funktion vor der Übergabe
				und geben {business.warrantyMonths} Monate Garantie auf Teile und Arbeit.<a class="fn" href="#fn-3">3</a>
			</p>
		</div>
		<figure class="workshop__img sd-grow">
			<img
				src="/img/schraube-1600.webp"
				srcset="/img/schraube-800.webp 800w, /img/schraube-1200.webp 1200w, /img/schraube-1600.webp 1600w, /img/schraube-2400.webp 2400w"
				sizes="(max-width: 1100px) 100vw, 1100px"
				width="2400"
				height="1600"
				alt="Präzisionsschraubendreher an einem geöffneten Smartphone"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>

	<section class="dir section on-gray" aria-labelledby="dir-h">
		<div class="wrap wrap--xl">
			<div class="dir__intro" data-reveal>
				<h2 id="dir-h" class="t-section">Alle Reparaturen in Wien.</h2>
				<p class="t-lead muted">
					Ohne Termin an unseren Standorten {places.join(", ").replace(/, ([^,]*)$/, " und $1")}. Oder vorab <a href="/reparatur-anfragen">online anfragen</a>.
				</p>
			</div>
			<div class="dir__cols">
				{
					directory.map((col, i) => (
						<div data-reveal style={`--i:${i}`}>
							<h3 class="dir__h">
								<a href={col.href}>{col.title}</a>
							</h3>
							<ul role="list">
								{col.links.map(([href, label]) => (
									<li>
										<a href={href}>{label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>
	<FAQ title="Häufige Fragen." items={homeFaq} />

	<Closing />
</Base>

<style>
	.chapters {
		background: var(--paper);
		border-bottom: 1px solid #e8e8ed;
	}

	.chapters ul {
		display: flex;
		justify-content: center;
		gap: clamp(8px, 3vw, 36px);
		list-style: none;
		margin: 0 auto;
		padding: 18px 16px 14px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.chapters a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		min-width: 84px;
		color: var(--ink);
		font-size: 14px;
		letter-spacing: -0.01em;
	}

	.chapters a:hover {
		color: var(--link);
		text-decoration: none;
	}

	.chapters svg {
		width: 40px;
		height: 40px;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		padding: 12px;
	}

	@media (max-width: 734px) {
		.grid {
			grid-template-columns: 1fr;
			padding: 12px 0;
		}
	}

	@media (max-width: 600px) {
		.chapters ul {
			justify-content: flex-start;
			-webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
			mask-image: linear-gradient(90deg, #000 85%, transparent);
		}
	}

	.dir__intro {
		max-width: 760px;
		margin-bottom: clamp(32px, 4vw, 56px);
	}
	.dir__intro .t-lead {
		margin-top: 18px;
	}
	.dir__cols {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 32px;
	}
	.dir__h {
		margin-bottom: 12px;
		font-size: 21px;
		font-weight: 600;
	}
	.dir__h a {
		color: var(--ink);
	}
	.dir ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.dir li {
		padding: 8px 0;
		border-bottom: 1px solid var(--line);
	}
	@media (max-width: 1000px) {
		.dir__cols {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 520px) {
		.dir__cols {
			grid-template-columns: 1fr;
		}
	}
	.workshop {
		padding-top: clamp(88px, 12vw, 160px);
		overflow: hidden;
		text-align: center;
	}

	.workshop__copy {
		max-width: 820px;
	}

	.workshop__lead {
		margin: 24px auto 0;
		max-width: 640px;
		color: var(--faint);
	}

	.workshop__lead :global(.fn) {
		color: var(--faint);
	}

	.workshop__img {
		width: min(1100px, 100%);
		margin: clamp(48px, 7vw, 80px) auto 0;
	}

	.workshop__img img {
		width: 100%;
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
	}
</style>
