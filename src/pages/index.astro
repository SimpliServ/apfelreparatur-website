---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";
import Tile from "../components/Tile.astro";
import PlusCards from "../components/PlusCards.astro";
import Steps from "../components/Steps.astro";
import FAQ from "../components/FAQ.astro";
import Closing from "../components/Closing.astro";
import RepairDirectory from "../components/RepairDirectory.astro";
import DevicePicker from "../components/DevicePicker.astro";
import { homeFaq, steps, whyCards } from "../lib/copy";
import { faqLd, localBusinessLd } from "../lib/seo";
import { business } from "../lib/business";
import { getLocations } from "../lib/mobinil";
import ModelGrid from "../components/ModelGrid.astro";
import { loadModels, popular, useHints } from "../lib/devices";

const locations = await getLocations();
const places = [...new Set(locations.map((l) => l.name))];
const catalogue = await loadModels().catch(() => ({ models: [], cacheHint: undefined }));
useHints(Astro, catalogue.cacheHint);
const top = popular(catalogue.models);

const chapters = [
	["/iphone", "ph:device-mobile", "iPhone"],
	["/ipad", "ph:device-tablet", "iPad"],
	["/mac", "ph:laptop", "Mac"],
	["/imac", "ph:desktop", "iMac"],
	["/apple-watch", "ph:watch", "Watch"],
	["/datenrettung", "ph:database", "Datenrettung"],
	["/datenrettung#uebertragung", "ph:arrows-left-right", "Datenübertragung"],
	["/kontakt", "ph:map-pin", "Standorte"],
] as const;
---

<Base
	title="Apple Reparatur Wien ohne Termin – Apfelreparatur"
	description={`Apple Reparatur in Wien ohne Termin: iPhone Display, Batterie und Rückglas mit Original Apple Teilen. Auch iPad, MacBook, Apple Watch, Datenrettung. Preis vorab, ${business.warrantyMonths} Monate Garantie.`}
	jsonLd={[...localBusinessLd(locations), faqLd(homeFaq)]}
>
	<nav class="chapters" aria-label="Geräte und Leistungen">
		<ul role="list" class="rise">
			{
				chapters.map(([href, icon, label]) => (
					<li>
						<a href={href}>
							<Icon name={icon} aria-hidden="true" />
							<span>{label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<Tile
		heading="h1"
		eager
		photo="hero"
		eyebrow="Apple Reparatur in Wien"
		title="Wie am ersten Tag."
		sub={'Premium Reparaturen mit Original Apple Teilen.<a class="fn" href="#fn-1">1</a>'}
		primary={{ href: "/kontakt", label: "Ohne Termin vorbeikommen" }}
		secondary={{ href: "#geraete", label: "Gerät wählen" }}
	/>

	<DevicePicker id="geraete" title="Reparatur nach Gerät auswählen." models={catalogue.models} />

	<div class="grid">
		<Tile
			half
			photo="display"
			title="Display."
			sub="Gesprungen? Bald wieder makellos."
			primary={{ href: "/iphone/display-reparatur", label: "Mehr erfahren" }}
			secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
		/>
		<Tile
			half
			photo="rueckglas"
			title="Rückglas."
			sub="Die Rückseite, wieder aus einem Guss."
			primary={{ href: "/iphone/rueckglas-reparatur", label: "Mehr erfahren" }}
			secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
		/>
		<Tile
			half
			photo="akku"
			title="Akku."
			sub="Wieder 100 % Batteriezustand."
			primary={{ href: "/iphone/batterietausch", label: "Mehr erfahren" }}
			secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
		/>
		<Tile
			half
			photo="daten"
			title="Datenrettung."
			sub="Fotos, Nachrichten, Dateien. Zurückgeholt."
			primary={{ href: "/datenrettung", label: "Mehr erfahren" }}
			secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
		/>
		<Tile
			half
			photo="ipad"
			title="iPad."
			sub="Glas, Display und Akku. Wie neu."
			primary={{ href: "/ipad", label: "Mehr erfahren" }}
			secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
		/>
		<Tile
			half
			photo="mac-hero"
			title="Mac."
			sub="MacBook Air, MacBook Pro und iMac."
			primary={{ href: "/mac", label: "Mehr erfahren" }}
			secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
		/>
	</div>

	<Tile
		photo="watch"
		eyebrow="Apple Watch Reparatur"
		title="Apple Watch."
		sub="Display und Akku. Wieder bereit für jeden Tag."
		primary={{ href: "/apple-watch", label: "Mehr erfahren" }}
		secondary={{ href: "/kontakt", label: "Vorbeikommen" }}
	/>

	{
		top.length > 0 && (
			<section id="preise" class="prices section" aria-labelledby="preise-h">
				<div class="wrap wrap--xl">
					<div class="center prices__head" data-reveal>
						<h2 id="preise-h" class="t-section">Preise für Ihr Modell.</h2>
						<p class="t-lead muted">Fixpreise für jedes iPhone und iPad, wahlweise mit Original Apple Teilen.<a class="fn" href="#fn-1">1</a> Wählen Sie Ihr Modell für alle Reparaturen.</p>
					</div>
					<ModelGrid models={top} />
					<ul class="prices__all" role="list">
						{[["/iphone#modelle", "Alle iPhone Modelle"], ["/ipad#modelle", "Alle iPad Modelle"], ["/mac#modelle", "Alle Mac Modelle"], ["/apple-watch#modelle", "Alle Apple Watch Modelle"]].map(([href, label]) => (
							<li>
								<a class="more" href={href}>
									{label} <Icon name="ph:caret-right" aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<PlusCards id="warum" title="Warum Apfelreparatur." link={{ href: "/#garantie", label: "Garantie und Bedingungen ›" }} cards={whyCards} />

	<Steps id="ablauf" title="So einfach geht’s." items={steps} />

	<section class="workshop on-dark" id="garantie">
		<div class="wrap workshop__copy" data-reveal>
			<p class="t-eyebrow muted">Unsere Arbeitsweise</p>
			<h2 class="t-display sd-text">Präzision in jedem Detail.</h2>
			<p class="t-lead workshop__lead">
				Jede Reparatur beginnt mit einer gründlichen Diagnose. Wir tauschen nur, was wirklich defekt ist, testen jede Funktion vor der Übergabe
				und geben {business.warrantyMonths} Monate Garantie auf Teile und Arbeit.<a class="fn" href="#fn-3">3</a>
			</p>
		</div>
		<figure class="workshop__img sd-grow">
			<img
				src="/img/schraube-1600.webp"
				srcset="/img/schraube-800.webp 800w, /img/schraube-1200.webp 1200w, /img/schraube-1600.webp 1600w, /img/schraube-2400.webp 2400w"
				sizes="(max-width: 1100px) 100vw, 1100px"
				width="2400"
				height="1600"
				alt="Präzisionsschraubendreher an einem geöffneten Smartphone"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>

	<RepairDirectory title="Alle Reparaturen in Wien.">
		Ohne Termin an unseren Standorten {places.join(", ").replace(/, ([^,]*)$/, " und $1")}, auch am Wochenende.
	</RepairDirectory>

	<FAQ title="Häufige Fragen." items={homeFaq} />

	<Closing />
</Base>

<style>
	.chapters {
		background: var(--paper);
		border-bottom: 1px solid #e8e8ed;
	}

	.chapters ul {
		display: flex;
		justify-content: center;
		gap: clamp(8px, 3vw, 36px);
		list-style: none;
		margin: 0 auto;
		padding: 18px 16px 14px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.chapters a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		min-width: 84px;
		color: var(--ink);
		font-size: 14px;
		letter-spacing: -0.01em;
	}

	.chapters a:hover {
		color: var(--link);
		text-decoration: none;
	}

	.chapters svg {
		width: 40px;
		height: 40px;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		padding: 12px;
	}

	@media (max-width: 734px) {
		.grid {
			grid-template-columns: 1fr;
			padding: 12px 0;
		}
	}

	@media (max-width: 600px) {
		.chapters ul {
			justify-content: flex-start;
			-webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
			mask-image: linear-gradient(90deg, #000 85%, transparent);
		}
	}

	.workshop {
		padding-top: clamp(88px, 12vw, 160px);
		overflow: hidden;
		text-align: center;
	}

	.workshop__copy {
		max-width: 820px;
	}

	.workshop__lead {
		margin: 24px auto 0;
		max-width: 640px;
		color: var(--faint);
	}

	.workshop__lead :global(.fn) {
		color: var(--faint);
	}

	.workshop__img {
		width: min(1100px, 100%);
		margin: clamp(48px, 7vw, 80px) auto 0;
	}

	.workshop__img img {
		width: 100%;
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
	}

	.prices__head {
		max-width: 760px;
		margin: 0 auto clamp(32px, 4vw, 48px);
	}

	.prices__head .t-lead {
		margin-top: 12px;
	}

	@media (min-width: 735px) {
		.prices :global(.mgrid__list) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			max-width: 1040px;
			margin-inline: auto;
		}
	}

	.prices__all {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px 32px;
		margin: clamp(32px, 4vw, 48px) 0 0;
		padding: 0;
		list-style: none;
		font-size: 17px;
	}
</style>
