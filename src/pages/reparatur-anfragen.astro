---
import { Icon } from "astro-iconset/components";
import Base from "../layouts/Base.astro";
import { devices } from "../lib/content";
import { inquiry } from "../lib/inquiry-copy";
import { sendToPlugin } from "../lib/send";
import { getModels } from "../lib/mobinil";
import { business } from "../lib/business";
import { breadcrumbLd } from "../lib/seo";

Astro.response.headers.set("Cache-Control", "private, no-store");

const deviceOptions = [
	["iphone", "iPhone", "ph:device-mobile"],
	["ipad", "iPad", "ph:device-tablet"],
	["mac", "Mac", "ph:laptop"],
	["andere", "Anderes", "ph:devices"],
] as const;
const issueOptions: Record<string, string[]> = {
	iphone: ["display", "rueckglas", "akku", "kamera", "ladebuchse", "datenrettung", "datenuebertragung", "sonstiges"],
	ipad: ["display", "akku", "ladebuchse", "datenrettung", "datenuebertragung", "sonstiges"],
	mac: ["display", "akku", "tastatur", "datenrettung", "datenuebertragung", "sonstiges"],
	andere: ["display", "akku", "datenrettung", "datenuebertragung", "sonstiges"],
};
const allIssues = Object.keys(inquiry.issues);

let values: Record<string, string> = {
	device: Astro.url.searchParams.get("geraet") ?? "",
	contact: "email",
};
let issues: string[] = (Astro.url.searchParams.get("anliegen") ?? "").split(",").filter((k) => allIssues.includes(k));
let error = "";
const sent = Astro.request.method === "GET" && Astro.url.searchParams.has("gesendet");

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	values = Object.fromEntries([...form.entries()].filter(([k]) => k !== "issues").map(([k, v]) => [k, String(v)]));
	issues = form.getAll("issues").map(String);
	const res = await sendToPlugin(Astro.locals, Astro.url, "repair", { ...values, issues, consent: values.consent === "on" }, Astro.request);
	if (res.ok) return Astro.redirect("/reparatur-anfragen?gesendet=1", 303);
	error = inquiry.error[res.error] ?? inquiry.error.UNAVAILABLE;
}

const live = await Promise.all(Object.values(devices).map(async (d) => [d.key, (await getModels(d.key)).map((m) => m.title)] as const));
const models = Object.fromEntries(live);
const visible = issueOptions[values.device] ?? allIssues;
---

<Base
	og="anfragen"
	title="Reparatur anfragen – iPhone, iPad & Mac Reparatur Wien"
	description="Reparatur in Wien anfragen: Gerät und Problem angeben, wir melden uns mit einer ersten Preiseinschätzung. Kostenlos und ohne Verpflichtung."
	jsonLd={[breadcrumbLd([["Start", "/"], ["Reparatur anfragen", "/reparatur-anfragen"]])]}
>
	{
		sent ? (
			<section class="done section">
				<div class="wrap wrap--narrow center" data-reveal>
					<Icon name="ph:check-circle-fill" class="done__icon" aria-hidden="true" />
					<h1 class="t-display">Danke.</h1>
					<p class="t-hero-sub done__sub">Ihre Anfrage ist bei uns. Wir melden uns mit einer ersten Einschätzung. Sie können jederzeit ohne Termin an einem unserer Standorte vorbeikommen.</p>
					<p class="muted">Eine Bestätigung ist unterwegs in Ihr Postfach.</p>
					<div class="btn-row done__ctas">
						<a class="btn" href="/">Zur Startseite</a>
						<a class="btn btn--ghost" href="/reparatur-anfragen">Weitere Anfrage</a>
					</div>
				</div>
			</section>
		) : (
			<>
				<header class="head">
					<div class="wrap wrap--xl rise">
						<p class="t-eyebrow head__eyebrow">Kostenlos und ohne Verpflichtung</p>
						<h1 class="t-display">Reparatur anfragen.</h1>
						<p class="t-hero-sub head__sub">Ein paar Angaben. Wir melden uns mit einer ersten Preiseinschätzung.</p>
					</div>
				</header>

				<form method="post" class="cfg wrap wrap--xl" novalidate data-form toolname="request_repair" tooldescription="Reparaturanfrage für iPhone, iPad oder Mac an Apfelreparatur in Wien senden">
					{error && (
						<p class="cfg__error" role="alert">
							<Icon name="ph:warning-circle" aria-hidden="true" />
							{error}
						</p>
					)}

					<div class="row" role="group" aria-labelledby="g-device">
						<h2 class="row__h" id="g-device">
							<span>Gerät.</span> <span class="muted">Was dürfen wir reparieren?</span>
						</h2>
						<div class="row__body choices choices--device">
							{deviceOptions.map(([key, label, icon]) => (
								<label class="choice">
									<input type="radio" name="device" value={key} required checked={values.device === key} />
									<span class="choice__box">
										<Icon name={icon} aria-hidden="true" />
										<span class="choice__label">{label}</span>
									</span>
								</label>
							))}
							<div class="field field--full">
								<input id="model" name="model" list="models" value={values.model ?? ""} placeholder=" " autocomplete="off" maxlength="80" />
								<label for="model">Modell (optional)</label>
								<datalist id="models" data-models={JSON.stringify(models)}>
									{(models[values.device as keyof typeof models] ?? []).map((m) => <option value={m} />)}
								</datalist>
							</div>
						</div>
					</div>

					<div class="row" role="group" aria-labelledby="g-issue">
						<h2 class="row__h" id="g-issue">
							<span>Anliegen.</span> <span class="muted">Was ist passiert?</span>
						</h2>
						<div class="row__body">
							<div class="choices choices--issues" data-issues={JSON.stringify(issueOptions)}>
								{allIssues.map((key) => (
									<label class="choice choice--pill" hidden={!visible.includes(key)} data-issue={key}>
										<input type="checkbox" name="issues" value={key} checked={issues.includes(key)} />
										<span class="choice__box">
											<span class="choice__label">{inquiry.issues[key]}</span>
										</span>
									</label>
								))}
							</div>
							<div class="field field--full field--area">
								<textarea id="message" name="message" rows="4" placeholder=" " maxlength="3000">{values.message ?? ""}</textarea>
								<label for="message">Was ist passiert? (optional)</label>
							</div>
						</div>
					</div>

					<div class="row" role="group" aria-labelledby="g-contact">
						<h2 class="row__h" id="g-contact">
							<span>Kontakt.</span> <span class="muted">Wie erreichen wir Sie?</span>
						</h2>
						<div class="row__body">
							<div class="fields">
								<div class="field field--full">
									<input id="name" name="name" required autocomplete="name" value={values.name ?? ""} placeholder=" " maxlength="120" />
									<label for="name">Vor- und Nachname</label>
								</div>
								<div class="field">
									<input id="email" name="email" type="email" required autocomplete="email" value={values.email ?? ""} placeholder=" " maxlength="160" />
									<label for="email">E-Mail</label>
								</div>
								<div class="field">
									<input id="phone" name="phone" type="tel" autocomplete="tel" value={values.phone ?? ""} placeholder=" " maxlength="40" />
									<label for="phone">Telefon (optional)</label>
								</div>
							</div>
							<p class="row__label">Rückmeldung bevorzugt</p>
							<div class="choices choices--contact">
								{Object.entries(inquiry.contacts).map(([key, label]) => (
									<label class="choice choice--pill">
										<input type="radio" name="contact" value={key} checked={(values.contact ?? "email") === key} />
										<span class="choice__box">
											<span class="choice__label">{label}</span>
										</span>
									</label>
								))}
							</div>
						</div>
					</div>

					<div class="row row--submit">
						<div class="row__h" aria-hidden="true"></div>
						<div class="row__body">
							<label class="consent">
								<input type="checkbox" name="consent" required checked={values.consent === "on"} />
								<span>
									Ich habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> zur Kenntnis genommen. Meine Angaben werden nur zur
									Bearbeitung dieser Anfrage verwendet.
								</span>
							</label>
							<div class="hp" aria-hidden="true">
								<label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
							</div>
							<button class="btn btn--lg cfg__submit" type="submit">Anfrage senden</button>
							<p class="cfg__small muted">
								Die Anfrage ist kostenlos und verpflichtet Sie zu nichts. Lieber direkt schreiben? <a href={`mailto:${business.email}`}>{business.email}</a>
							</p>
						</div>
					</div>
				</form>
			</>
		)
	}
</Base>

<script>
	const found = document.querySelector<HTMLFormElement>("[data-form]");
	if (found) {
		const form: HTMLFormElement = found;
		const models = JSON.parse(form.querySelector<HTMLElement>("[data-models]")!.dataset.models!) as Record<string, string[]>;
		const issueMap = JSON.parse(form.querySelector<HTMLElement>("[data-issues]")!.dataset.issues!) as Record<string, string[]>;
		const list = form.querySelector("datalist")!;
		const sync = () => {
			const device = (form.elements.namedItem("device") as RadioNodeList).value;
			list.replaceChildren(...(models[device] ?? []).map((m) => Object.assign(document.createElement("option"), { value: m })));
			const allowed = issueMap[device];
			form.querySelectorAll<HTMLLabelElement>("[data-issue]").forEach((el) => {
				const show = !allowed || allowed.includes(el.dataset.issue!);
				el.hidden = !show;
				if (!show) el.querySelector("input")!.checked = false;
			});
		};
		form.addEventListener("change", (e) => (e.target as HTMLInputElement).name === "device" && sync());

		form.addEventListener("submit", (e) => {
			const msgs: string[] = [];
			form.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
			const flag = (el: Element | null, msg: string) => {
				el?.classList.add("is-invalid");
				msgs.push(msg);
			};
			const name = form.elements.namedItem("name") as HTMLInputElement;
			const email = form.elements.namedItem("email") as HTMLInputElement;
			const phone = form.elements.namedItem("phone") as HTMLInputElement;
			const consent = form.elements.namedItem("consent") as HTMLInputElement;
			if (!(form.elements.namedItem("device") as RadioNodeList).value) flag(form.querySelector(".choices--device"), "Bitte wählen Sie Ihr Gerät.");
			if (!form.querySelector("input[name=issues]:checked")) flag(form.querySelector(".choices--issues"), "Bitte wählen Sie mindestens ein Anliegen.");
			if (!name.value.trim()) flag(name.parentElement, "Bitte geben Sie Ihren Namen an.");
			if (!email.validity.valid || !email.value) flag(email.parentElement, "Bitte geben Sie eine gültige E-Mail-Adresse an.");
			if ((form.elements.namedItem("contact") as RadioNodeList).value === "telefon" && !phone.value.trim()) flag(phone.parentElement, "Für einen Rückruf brauchen wir Ihre Telefonnummer.");
			if (!consent.checked) flag(consent.parentElement, "Bitte bestätigen Sie, dass Sie die Datenschutzerklärung zur Kenntnis genommen haben.");
			if (!msgs.length) return;
			e.preventDefault();
			let box = form.querySelector<HTMLElement>(".cfg__error");
			if (!box) {
				box = document.createElement("div");
				box.className = "cfg__error";
				box.setAttribute("role", "alert");
				form.insertBefore(box, form.firstChild);
			}
			box.replaceChildren(...msgs.map((m) => Object.assign(document.createElement("p"), { textContent: m })));
			box.scrollIntoView({ behavior: "smooth", block: "center" });
		});
	}
</script>

<style>
	.head {
		padding: clamp(56px, 8vw, 96px) 0 clamp(32px, 5vw, 56px);
	}

	.head__eyebrow {
		color: #f56300;
		margin-bottom: 8px;
	}

	.head__sub {
		max-width: 28ch;
		margin-top: 16px;
		color: var(--muted);
	}

	.cfg {
		padding-bottom: clamp(72px, 10vw, 120px);
	}

	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr);
		gap: 24px 64px;
		padding: 48px 0;
		border-top: 1px solid var(--line);
	}

	.row__h {
		font-size: clamp(24px, 2.4vw, 28px);
		line-height: 1.14;
		font-weight: 600;
		letter-spacing: 0.007em;
	}

	.row__label {
		margin: 28px 0 12px;
		font-size: 14px;
		font-weight: 600;
	}

	.choices {
		display: grid;
		gap: 14px;
	}

	.choices--device {
		grid-template-columns: repeat(4, 1fr);
	}

	.choices--issues {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.choices--contact {
		display: flex;
		gap: 10px;
	}

	.choice {
		position: relative;
		cursor: pointer;
	}

	.choice[hidden] {
		display: none;
	}

	.choice input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.choice__box {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		height: 100%;
		min-height: 120px;
		padding: 18px 12px;
		border: 1px solid var(--faint);
		border-radius: 12px;
		background: var(--paper);
		transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
	}

	.choice__box svg {
		width: 36px;
		height: 36px;
	}

	.choice__label {
		font-size: 17px;
		font-weight: 600;
	}

	.choice:hover .choice__box {
		border-color: var(--ink-2);
	}

	.choice input:checked + .choice__box {
		border-color: var(--blue);
		box-shadow: 0 0 0 1px var(--blue);
	}

	.choice input:focus-visible + .choice__box {
		outline: 2px solid var(--blue);
		outline-offset: 3px;
	}

	.choice--pill .choice__box {
		min-height: 0;
		padding: 11px 18px;
		border-radius: 980px;
	}

	.choice--pill .choice__label {
		font-size: 15px;
		font-weight: 500;
	}

	.fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}

	.field {
		position: relative;
	}

	.field--full {
		grid-column: 1 / -1;
	}

	.choices--device .field,
	.field--area {
		margin-top: 14px;
	}

	.choices--device .field {
		margin-top: 0;
	}

	.field input,
	.field textarea {
		width: 100%;
		height: 56px;
		padding: 26px 16px 8px;
		border: 1px solid var(--faint);
		border-radius: 12px;
		background: var(--paper);
		font-size: 17px;
		line-height: 1.23;
		outline: none;
		transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
	}

	.field textarea {
		height: auto;
		min-height: 120px;
		resize: vertical;
	}

	.field label {
		position: absolute;
		left: 17px;
		top: 17px;
		right: 16px;
		font-size: 17px;
		color: var(--muted);
		pointer-events: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transform-origin: left top;
		transition: transform 0.15s var(--ease), color 0.15s var(--ease);
	}

	.field input:focus,
	.field textarea:focus {
		border-color: var(--blue);
		box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.2);
	}

	.field input:focus + label,
	.field input:not(:placeholder-shown) + label,
	.field textarea:focus + label,
	.field textarea:not(:placeholder-shown) + label {
		transform: translateY(-9px) scale(0.71);
	}

	:global(.is-invalid) .choice__box,
	:global(.is-invalid) input,
	:global(.is-invalid) textarea {
		border-color: var(--err);
	}

	:global(.consent.is-invalid) {
		color: var(--err);
	}

	.consent {
		display: flex;
		gap: 12px;
		align-items: flex-start;
		font-size: 14px;
		line-height: 1.43;
		color: var(--ink-2);
		cursor: pointer;
	}

	.consent input {
		flex: none;
		width: 20px;
		height: 20px;
		margin: 0;
		accent-color: var(--blue);
	}

	.hp {
		position: absolute;
		left: -9999px;
	}

	.cfg__submit {
		width: 100%;
		margin: 28px 0 14px;
		font-weight: 400;
	}

	.cfg__small {
		font-size: 12px;
		text-align: center;
	}

	:global(.cfg__error) {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-bottom: 24px;
		padding: 16px 20px;
		border-radius: 12px;
		background: #fff2f2;
		color: var(--err);
		font-size: 15px;
	}

	:global(.cfg__error) svg {
		width: 20px;
		height: 20px;
	}

	.done {
		min-height: 70vh;
		display: flex;
		align-items: center;
	}

	.done__icon {
		width: 64px;
		height: 64px;
		color: var(--ok);
		margin: 0 auto 20px;
	}

	.done__sub {
		margin: 18px auto 12px;
		max-width: 26ch;
	}

	.done__ctas {
		margin-top: 32px;
	}

	@media (max-width: 900px) {
		.row {
			grid-template-columns: 1fr;
			padding: 36px 0;
		}

		.row__h:empty {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.choices--device {
			grid-template-columns: 1fr 1fr;
		}

		.fields {
			grid-template-columns: 1fr;
		}
	}
</style>
